---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BAZNAS Kabupaten Bandung - Portal Layanan Publik & Transparansi ZIS",
  description = "Portal resmi BAZNAS Kabupaten Bandung: Program ZIS, Campaign Kemanusiaan, Layanan Pengajuan Bantuan NIK, Kolaborasi Mitra, Kantor Layanan, Kalkulator Zakat, Dashboard Penghimpunan & Penyaluran, Berita, dan Profil Lembaga."
} = Astro.props;

import PublicHeader from '../components/public/PublicHeader.astro';
import PublicFooter from '../components/public/PublicFooter.astro';
import PublicModals from '../components/public/PublicModals.astro';
import '../styles/global.css';
import '../styles/animations.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>

  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  
  

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp"/>
  <link rel="shortcut icon" type="image/webp" href="/favicon.webp"/>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,400..700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet"/>

  <!-- Leaflet Interactive Maps -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>


  <style is:global>
    html, body {
      margin: 0;
      padding: 0;
      background-color: #f4f4f5;
      font-family: 'DM Sans', 'Plus Jakarta Sans', sans-serif;
      color: #18181b;
      -webkit-font-smoothing: antialiased;
      scroll-behavior: smooth;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }

    /* ---- SPA View Caching (Faster View Transitions) ---- */
    .spa-view { width: 100%; outline: none; }
    .spa-view.inactive {
      content-visibility: hidden;
      position: absolute;
      inset: 0 auto auto 0;
      height: 0;
      overflow: hidden;
      pointer-events: none;
    }
    @supports not (content-visibility: hidden) {
      .spa-view.inactive { display: none; }
    }

    /* ---- Navigasi dropdown & items di public header ---- */
    .pub-nav-btn {
      color: #3f3f46;
      transition: all 0.15s ease;
    }
    .pub-nav-btn:hover,
    .group:hover .pub-nav-btn {
      color: #064e3b;
      background-color: #ececee;
    }
    .pub-nav-btn.active {
      background-color: #064e3b;
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(6,78,59,0.25);
    }

    /* Dropdown Menus */
    .pub-dropdown-menu {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), transform 160ms cubic-bezier(0.16, 1, 0.3, 1), visibility 160ms ease;
    }
    .group:hover .pub-dropdown-menu,
    .group:focus-within .pub-dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* Modal Animation */
    .modal-enter { animation: modalFadeIn 200ms ease-out forwards; }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.97) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ---- View Transitions ---- */
    ::view-transition-old(root) { animation: 140ms ease-in both app-fade-out; }
    ::view-transition-new(root) { animation: 200ms ease-out both app-fade-in; }
    @keyframes app-fade-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
    @keyframes app-fade-out { from { opacity: 1; } to { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
    }

    /* ===== Style asli per layar ===== */
    /* layar 3 */ @layer base {
input[type=number]::-webkit-inner-spin-button, 
      input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
      }
}
/* layar 3 */ .custom-border {
      border: 1px solid #ececee;
    }
/* layar 2 */ @layer base {
main > :first-child { margin-top: 0 !important; }
main > :last-child { margin-bottom: 0 !important; }
}
  </style>
</head>
<body class="bg-[#f4f4f5] text-[#18181b] min-h-screen selection:bg-[#064e3b] selection:text-white flex flex-col">
  <PublicHeader />

  <slot />

  <PublicFooter />

  <PublicModals />

  <script src="../public.js"></script>
</body>
</html>
