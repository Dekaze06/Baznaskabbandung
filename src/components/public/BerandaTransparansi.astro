---
import InkOrbitFeatures from '../ui/ink-orbit-features';
import MitraMarquee from '../ui/mitra-marquee';
import BerandaCarousel from './BerandaCarousel';
---

<section id="view-transparansi" class="spa-view" tabindex="-1" aria-hidden="false">
  <div class="w-full">
    
<!-- Hero Section (Awesomic Editorial Style) -->
<section class="max-w-[1400px] mx-auto px-6 pt-14 sm:pt-16 lg:pt-24 xl:pt-28 pb-16 sm:pb-20 lg:pb-28 reveal-on-scroll">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
<!-- Text Column -->
<div class="lg:col-span-5 space-y-6 lg:space-y-7 reveal-left">
<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-obsidian leading-[1.08]">
            Tunaikan Zakat, Bangun Kemandirian Umat.
          </h1>
<p class="text-base sm:text-lg text-steel max-w-xl font-normal leading-relaxed">
            Pengelolaan zakat transparan dan akuntabel di Kabupaten Bandung. Dilengkapi Bukti Setor Zakat (BSZ) resmi yang diakui pengurang pajak bruto.
          </p>
<div class="flex flex-wrap items-center gap-3 pt-2">
<a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-[14px] bg-emerald-deep hover:bg-emerald-vibrant text-white font-medium text-sm transition-all" href="#kalkulator" data-route="kalkulator">
<span>Hitung &amp; Bayar Zakat</span>
<span class="material-symbols-outlined text-base">north_east</span>
</a>
<a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-[14px] bg-paper-s6 border border-mist-s6 hover:border-steel text-obsidian font-medium text-sm transition-all" href="#mustahik" data-route="mustahik">
<span>Ajukan Bantuan</span>
</a>
<button class="inline-flex items-center gap-1.5 px-4 py-3.5 rounded-[14px] text-xs font-mono-s6 text-steel hover:text-obsidian" id="btnQuickBszVerify">
<span class="material-symbols-outlined text-base">qr_code_scanner</span>
<span>Cek BSZ</span>
</button>
</div>
<!-- Quick Proof Chips (Informasi Publik BAZNAS) -->
<div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 stagger-container">
<div class="bg-paper-s6 p-3 rounded-[16px] border border-mist-s6" title="Lebih dari 43.890 jiwa mustahik telah menerima manfaat program BAZNAS Kabupaten Bandung">
<span class="block text-[10px] font-mono-s6 uppercase tracking-wider text-ash-s6 truncate">Penerima Manfaat</span>
<span class="text-sm font-semibold text-obsidian whitespace-nowrap">43.890+ Jiwa</span>
</div>
<div class="bg-paper-s6 p-3 rounded-[16px] border border-mist-s6" title="Bukti Setor Zakat (BSZ) resmi yang diakui Ditjen Pajak sebagai pengurang Penghasilan Kena Pajak (UU No. 23/2011)">
<span class="block text-[10px] font-mono-s6 uppercase tracking-wider text-ash-s6 truncate">Pengurang Pajak</span>
<span class="text-sm font-semibold text-emerald-deep whitespace-nowrap">BSZ Sah Resmi</span>
</div>
<div class="bg-paper-s6 p-3 rounded-[16px] border border-mist-s6" title="Penyaluran dan layanan menjangkau seluruh 31 kecamatan di Kabupaten Bandung">
<span class="block text-[10px] font-mono-s6 uppercase tracking-wider text-ash-s6 truncate">Jangkauan</span>
<span class="text-sm font-semibold text-obsidian whitespace-nowrap">31 Kecamatan</span>
</div>
<div class="bg-paper-s6 p-3 rounded-[16px] border border-mist-s6" title="Pelayanan dan pengajuan bantuan di BAZNAS Kabupaten Bandung 100% gratis tanpa perantara dan bebas biaya/pungli">
<span class="block text-[10px] font-mono-s6 uppercase tracking-wider text-ash-s6 truncate">Layanan Bantuan</span>
<span class="text-sm font-semibold text-emerald-deep whitespace-nowrap">100% Gratis</span>
</div>
</div>
</div>
<!-- Visual Hero Carousel (SqueezeCarousel) -->
<div class="lg:col-span-7 flex justify-center lg:justify-end w-full min-w-0">
  <BerandaCarousel client:load className="w-full" />
</div>
</div>
</section>
<!-- Transparansi Fiskal: Big Minimalist Stats Section -->
<section id="dashboard-penghimpunan" class="max-w-[1400px] mx-auto px-6 py-10 reveal-on-scroll">
<div class="bg-paper-s6 rounded-[36px] border border-mist-s6 p-8 lg:p-12 space-y-10">
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-cloud pb-6">
<div>
<h2 class="text-2xl sm:text-3xl font-bold text-obsidian tracking-tight mt-1">Transparansi Kinerja 2026</h2>
</div>
<div class="flex items-center gap-2 font-mono-s6 text-xs text-ash-s6">
<span class="w-2 h-2 rounded-full bg-emerald-vibrant"></span>
            Sinkron 2 mnt lalu
          </div>
</div>
<!-- Minimal 4 Big Number Metrics -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger-container">
<div class="space-y-2">
<div class="text-xs font-mono-s6 uppercase text-ash-s6 tracking-wider">Penghimpunan</div>
<div class="text-3xl lg:text-4xl font-bold text-obsidian tracking-tight">Rp 48.72 M</div>
<div class="text-xs text-emerald-deep font-medium flex items-center gap-1">
<span>↑ 14.2% YoY</span>
<span class="text-ash-s6">• Target 84.7%</span>
</div>
</div>
<div class="space-y-2">
<div class="text-xs font-mono-s6 uppercase text-ash-s6 tracking-wider">Penyaluran ZIS</div>
<div class="text-3xl lg:text-4xl font-bold text-obsidian tracking-tight">Rp 41.28 M</div>
<div class="text-xs text-steel font-medium flex items-center gap-1">
<span>ACR 84.7%</span>
<span class="px-1.5 py-0.5 rounded-[6px] bg-emerald-light text-emerald-deep text-[11px]">Sangat Efektif</span>
</div>
</div>
<div class="space-y-2">
<div class="text-xs font-mono-s6 uppercase text-ash-s6 tracking-wider">Penerima Manfaat</div>
<div class="text-3xl lg:text-4xl font-bold text-obsidian tracking-tight">43.890</div>
<div class="text-xs text-steel">Jiwa mustahik di 31 kecamatan</div>
</div>
<div class="space-y-2">
<div class="text-xs font-mono-s6 uppercase text-ash-s6 tracking-wider">Total Muzaki &amp; UPZ</div>
<div class="text-3xl lg:text-4xl font-bold text-obsidian tracking-tight">28.415</div>
<div class="text-xs text-steel">Transaksi • 487 UPZ Aktif</div>
</div>
</div>
<!-- Minimal Clean 8 Asnaf Meter -->
<div class="pt-6 border-t border-cloud space-y-4">
<div class="flex items-center justify-between text-xs">
<span class="font-bold text-obsidian">Sebaran Realisasi 8 Asnaf</span>
<span class="font-mono-s6 text-ash-s6">SK BAZNAS RI • Syariah 100%</span>
</div>
<!-- Continuous Bar -->
<div class="w-full h-3 rounded-full overflow-hidden flex bg-cloud">
<div class="bg-emerald-deep" style="width: 34%;" title="Miskin 34%"></div>
<div class="bg-emerald-vibrant" style="width: 28%;" title="Fakir 28%"></div>
<div class="bg-gold-warm" style="width: 15%;" title="Fisabilillah 15%"></div>
<div class="bg-amber-700" style="width: 11.8%;" title="Amil 11.8%"></div>
<div class="bg-steel" style="width: 4%;" title="Ibnu Sabil 4%"></div>
<div class="bg-zinc-400" style="width: 3.8%;" title="Gharimin 3.8%"></div>
<div class="bg-teal-700" style="width: 2.4%;" title="Muallaf 2.4%"></div>
<div class="bg-stone-300" style="width: 1%;" title="Riqab 1%"></div>
</div>
<!-- Minimal Chips -->
<div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 pt-2 text-xs">
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Miskin</span>
<span class="font-semibold text-obsidian mt-0.5">34.0%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Fakir</span>
<span class="font-semibold text-obsidian mt-0.5">28.0%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Fisabilillah</span>
<span class="font-semibold text-gold-warm mt-0.5">15.0%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Amil</span>
<span class="font-semibold text-obsidian mt-0.5">11.8%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Ibnu Sabil</span>
<span class="font-semibold text-obsidian mt-0.5">4.0%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Gharimin</span>
<span class="font-semibold text-obsidian mt-0.5">3.8%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Muallaf</span>
<span class="font-semibold text-obsidian mt-0.5">2.4%</span>
</div>
<div class="p-2 rounded-[12px] bg-canvas border border-mist-s6 flex flex-col">
<span class="text-ash-s6 text-[11px]">Riqab</span>
<span class="font-semibold text-obsidian mt-0.5">1.0%</span>
</div>
</div>
</div>
</div>
</section>

<!-- GIS Regional Section: Crisp Editorial Card with Interactive 31 Kecamatan Map -->
<section id="dashboard-penyaluran" class="max-w-[1400px] mx-auto px-6 py-10 reveal-on-scroll">
<div class="bg-paper-s6 rounded-[36px] border border-mist-s6 p-8 lg:p-12 space-y-8">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
<div>
<h2 class="text-2xl sm:text-3xl font-bold text-obsidian tracking-tight mt-1">Penyaluran ZIS 31 Kecamatan</h2>
<p class="text-xs text-steel mt-1">Sebaran peta interaktif realisasi bantuan dan mustahik se-Kabupaten Bandung</p>
</div>
<div class="flex items-center gap-2 flex-wrap">
<span class="px-3 py-1.5 rounded-[12px] bg-canvas border border-mist-s6 text-xs font-mono-s6 text-steel">
  340 Rutilahu Tuntas
</span>
<span class="px-3 py-1.5 rounded-[12px] bg-emerald-light text-emerald-deep text-xs font-mono-s6 font-semibold">
  31 Kecamatan Terverifikasi
</span>
</div>
</div>

<!-- Filter Controls: Region Tabs + Search Dropdown -->
<div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
  <!-- Region Filter Tabs -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-1" id="kecamatanRegionFilters">
    <button class="px-3.5 py-1.5 rounded-[12px] bg-emerald-deep text-white text-xs font-semibold shrink-0 transition-all filter-reg-btn active" data-region="all">
      Semua (31 Kec)
    </button>
    <button class="px-3.5 py-1.5 rounded-[12px] bg-canvas hover:bg-cloud border border-mist-s6 text-steel text-xs font-medium shrink-0 transition-all filter-reg-btn" data-region="selatan">
      Bandung Selatan (8)
    </button>
    <button class="px-3.5 py-1.5 rounded-[12px] bg-canvas hover:bg-cloud border border-mist-s6 text-steel text-xs font-medium shrink-0 transition-all filter-reg-btn" data-region="tengah">
      Bandung Tengah (10)
    </button>
    <button class="px-3.5 py-1.5 rounded-[12px] bg-canvas hover:bg-cloud border border-mist-s6 text-steel text-xs font-medium shrink-0 transition-all filter-reg-btn" data-region="timur">
      Bandung Timur (13)
    </button>
  </div>

  <!-- Quick Dropdown to Select any 31 Kecamatan -->
  <div class="flex items-center gap-2 shrink-0">
    <div class="relative w-full sm:w-64">
      <span class="material-symbols-outlined text-base text-ash-s6 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">search</span>
      <select id="kecamatanSelect" class="w-full pl-9 pr-8 py-2 rounded-[14px] bg-canvas border border-mist-s6 text-xs font-semibold text-obsidian outline-none cursor-pointer hover:border-steel focus:border-emerald-deep transition-all appearance-none" aria-label="Pilih Kecamatan">
        <option value="">Pilih Kecamatan (31)...</option>
      </select>
      <span class="material-symbols-outlined text-sm text-ash-s6 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">unfold_more</span>
    </div>
  </div>
</div>

<!-- Map & Telemetry Split -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
  <!-- 8 Cols: Map Canvas -->
  <div class="lg:col-span-8 relative rounded-[28px] overflow-hidden border border-mist-s6 min-h-[460px] lg:min-h-[500px] bg-[#e5e7eb] flex flex-col justify-between">
    <!-- Leaflet Map Canvas -->
    <div id="penyaluranMap" class="absolute inset-0 w-full h-full z-0"></div>

    <!-- Map Overlay Floating Header (Top-Left) -->
    <div class="relative z-10 m-4 self-start p-3.5 rounded-[18px] bg-white/95 backdrop-blur-md border border-mist-s6 shadow-sm pointer-events-auto">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-vibrant animate-pulse"></span>
        <span class="text-xs font-bold text-obsidian block" id="gisActiveTitle">Kabupaten Bandung</span>
      </div>
      <span class="text-[11px] text-steel mt-0.5 block" id="gisActiveSub">43.890 Penerima Manfaat Terverifikasi (31 Kecamatan)</span>
    </div>

    <!-- Map Overlay Floating Stat Chips (Bottom-Left) -->
    <div class="relative z-10 m-4 flex flex-wrap gap-2 pointer-events-auto">
      <span class="px-3 py-1.5 rounded-xl bg-white/95 backdrop-blur-md border border-mist-s6 text-xs font-mono-s6 font-bold text-obsidian shadow-sm">
        340 Rutilahu Tuntas
      </span>
      <span class="px-3 py-1.5 rounded-xl bg-white/95 backdrop-blur-md border border-mist-s6 text-xs font-mono-s6 font-bold text-emerald-deep shadow-sm">
        1.650 UMKM Mandiri
      </span>
      <span class="px-3 py-1.5 rounded-xl bg-white/95 backdrop-blur-md border border-mist-s6 text-xs font-mono-s6 font-bold text-obsidian shadow-sm">
        12.450 Bandung Sehat
      </span>
    </div>
  </div>

  <!-- 4 Cols: Side Telemetry Detail Card -->
  <div class="lg:col-span-4 flex flex-col justify-between p-6 sm:p-7 rounded-[28px] bg-canvas border border-mist-s6 space-y-6">
    <div class="space-y-4">
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-mono-s6 uppercase tracking-wider text-ash-s6 font-bold" id="detailKecamatanRegion">Wilayah Terpilih</span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-light text-emerald-deep text-[10px] font-bold" id="detailKecamatanDesa">10 Desa/Kel</span>
        </div>
        <h3 class="text-xl font-bold text-obsidian tracking-tight" id="detailKecamatanName">Kecamatan Soreang</h3>
        <p class="text-xs text-steel leading-relaxed" id="detailKecamatanHighlight">Ibukota Pemkab Bandung • Pusat Layanan Terpadu</p>
      </div>

      <div class="space-y-2.5 text-xs pt-1">
        <div class="flex justify-between items-center py-2 border-b border-mist-s6">
          <span class="text-steel">Penyaluran ZIS:</span>
          <span class="font-bold text-emerald-deep font-mono-s6 text-sm" id="detailKecamatanDana">Rp 2.450.000.000</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-mist-s6">
          <span class="text-steel">Penerima Manfaat:</span>
          <span class="font-semibold text-obsidian font-mono-s6" id="detailKecamatanMustahik">1.820 KK</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-mist-s6">
          <span class="text-steel">Bedah Rutilahu:</span>
          <span class="font-semibold text-obsidian font-mono-s6" id="detailKecamatanRutilahu">38 Unit</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-mist-s6">
          <span class="text-steel">Inkubasi UMKM:</span>
          <span class="font-semibold text-obsidian font-mono-s6" id="detailKecamatanZAuto">16 Titik</span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-steel">Beasiswa Pendidikan:</span>
          <span class="font-semibold text-obsidian font-mono-s6" id="detailKecamatanBeasiswa">142 Siswa</span>
        </div>
      </div>
    </div>

    <!-- Quick Desa Recommendation Action -->
    <div class="pt-4 border-t border-mist-s6 space-y-3">
      <div>
        <span class="text-xs font-bold text-obsidian block mb-1">Rekomendasi Mustahik Desa</span>
        <p class="text-xs text-steel leading-relaxed">Perangkat Desa / DKM UPZ dapat mendaftarkan warga yang berhak menerima zakat.</p>
      </div>
      <a class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-[14px] bg-emerald-deep hover:bg-emerald-vibrant text-white text-xs font-semibold transition-all shadow-xs" href="/layanan/bantuan">
        <span>Buka Formulir Pengajuan</span>
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </div>
</div>
</div>
</section>
<!-- Aksi Kemanusiaan: Campaign Darurat & Sedekah Terikat (36px radius) -->
<section id="campaign" class="max-w-[1400px] mx-auto px-6 py-10 reveal-on-scroll">
<div class="space-y-8">
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
<div>
<h2 class="text-2xl sm:text-3xl font-bold text-obsidian tracking-tight mt-1">Aksi Kemanusiaan &amp; Campaign Darurat</h2>
<p class="text-xs sm:text-sm text-steel mt-1 max-w-2xl leading-relaxed">Solidaritas infak dan sedekah terikat untuk merestorasi hunian dhuafa, respons cepat bencana, pangan lansia, dan armada medis di 31 kecamatan.</p>
</div>
<a class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-deep hover:text-emerald-vibrant shrink-0 group" href="/program/campaign">
<span>Lihat Semua Campaign</span>
<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
</a>
</div>

<!-- 4 Campaign Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 stagger-container">

<!-- Card 1: Rutilahu -->
<div class="bg-paper-s6 rounded-[36px] border border-mist-s6 overflow-hidden flex flex-col justify-between transition-all hover:border-steel hover:shadow-lg group">
<div>
<div class="relative h-48 w-full overflow-hidden bg-cloud">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/images/zis-peduli.webp" alt="Program Bedah 340 Rutilahu BAZNAS Kabupaten Bandung" loading="lazy" />
<span class="absolute top-3 left-3 px-3 py-1 rounded-[10px] bg-black/60 backdrop-blur-md text-[10px] font-mono-s6 font-medium text-white shadow-xs">Restorasi Hunian</span>
</div>
<div class="p-6 space-y-3.5">
<div class="space-y-1.5">
<h3 class="text-base sm:text-lg font-bold text-obsidian tracking-tight leading-snug line-clamp-2">Bedah 340 Rutilahu 2026</h3>
<p class="text-xs text-steel leading-relaxed line-clamp-3">Restorasi hunian dhuafa berlantai tanah dan bilik lapuk di pelosok desa menjadi rumah tinggal layak, sehat, dan tahan gempa.</p>
</div>

<div class="space-y-1.5 pt-2 border-t border-cloud">
<div class="flex items-center justify-between text-xs font-mono-s6">
<span class="text-ash-s6">Terkumpul:</span>
<span class="font-bold text-emerald-deep">Rp 4,85 M</span>
</div>
<div class="w-full h-2 rounded-full bg-cloud overflow-hidden">
<div class="h-full rounded-full bg-emerald-deep" style="width: 57.1%"></div>
</div>
<div class="flex items-center justify-between text-[11px] text-ash-s6">
<span>Target: Rp 8,50 M</span>
<span class="font-bold text-obsidian font-mono-s6">57.1%</span>
</div>
</div>

<div class="grid grid-cols-2 gap-2 text-center text-xs pt-1">
<div class="p-2 rounded-xl bg-canvas border border-mist-s6">
<span class="text-[10px] text-ash-s6 block">Tuntas</span>
<span class="font-mono-s6 font-bold text-emerald-deep text-xs">194 Rumah</span>
</div>
<div class="p-2 rounded-xl bg-canvas border border-mist-s6">
<span class="text-[10px] text-ash-s6 block">Pengerjaan</span>
<span class="font-mono-s6 font-bold text-obsidian text-xs">46 Rumah</span>
</div>
</div>
</div>
</div>
<div class="p-6 pt-0">
<button onclick="window.openQuickZisModal?.()" class="w-full py-3 rounded-[16px] bg-canvas hover:bg-emerald-deep text-obsidian hover:text-white border border-mist-s6 hover:border-emerald-deep text-xs font-semibold transition-all flex items-center justify-center gap-1.5 shadow-xs">
<span class="material-symbols-outlined text-base">payments</span>
<span>Donasi Rutilahu</span>
</button>
</div>
</div>

<!-- Card 2: Tanggap Bencana -->
<div class="bg-paper-s6 rounded-[36px] border border-mist-s6 overflow-hidden flex flex-col justify-between transition-all hover:border-steel hover:shadow-lg group">
<div>
<div class="relative h-48 w-full overflow-hidden bg-cloud">
<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/images/campaign-bencana.webp" alt="Aksi Tanggap Bencana BAZNAS Tanggap Bencana BTB" loading="lazy" />
<span class="absolute top-3 left-3 px-3 py-1 rounded-[10px] bg-black/60 backdrop-blur-md text-[10px] font-mono-s6 font-medium text-white shadow-xs">Tanggap Bencana</span>
</div>
<div class="p-6 space-y-3.5">
<div class="space-y-1.5">
<h3 class="text-base sm:text-lg font-bold text-obsidian tracking-tight leading-snug line-clamp-2">Dapur Umum &amp; Huntara</h3>
