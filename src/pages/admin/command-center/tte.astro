---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Otorisasi & Disposisi TTE BSrE - Panel Admin BAZNAS" sectionName="Ringkasan Strategis" pageTitle="Otorisasi & Disposisi TTE BSrE" activeRoute="command-center/tte">
  <main class="p-6 lg:p-8 space-y-7">

    <!-- Top Sub-Nav Pills -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Sub navigasi ringkasan eksekutif">
      <a href="/admin/command-center" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        <span>Ikhtisar Eksekutif</span>
      </a>
      <a href="/admin/command-center/tte" class="px-4 py-2 rounded-full text-xs font-bold bg-[#064e3b] text-white flex items-center gap-1.5 shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-sm">signature</span>
        <span>Otorisasi &amp; Disposisi TTE</span>
        <span class="px-1.5 py-0.2 rounded-full bg-[#ff5a00] text-white text-[10px] font-bold">8</span>
      </a>
      <a href="/admin/command-center/radar-wilayah" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">map</span>
        <span>Radar Sebaran 31 Kec.</span>
      </a>
      <a href="/admin/command-center/rkat" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">trending_up</span>
        <span>Capaian RKAT 2026</span>
      </a>
    </nav>

    <!-- Certificate & Authority Header Card -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] border border-[#064e3b]/20 flex items-center justify-center text-[#064e3b] shrink-0">
          <span class="material-symbols-outlined text-2xl">verified_user</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg font-bold text-[#09090b]">Antrean Disposisi TTE Elektronik Balai Sertifikasi (BSrE BSSN)</h1>
            <span class="px-2.5 py-0.5 rounded-full bg-[#ecfdf5] text-[#064e3b] font-mono text-xs font-bold border border-[#064e3b]/20">X.509 RSA-4096</span>
          </div>
          <p class="text-xs text-[#71717a] mt-1">
            Penandatangan Berwenang: <strong>Drs. H. M. Yusuf (Ketua BAZNAS Kab. Bandung)</strong> • Hash SHA-256 Otentik &amp; Sah di Pengadilan
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button type="button" data-action="open-tte" class="px-4 py-2 rounded-xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-semibold flex items-center gap-2 shadow-xs transition-all">
          <span class="material-symbols-outlined text-base">signature</span>
          <span>Buka Dialog TTE</span>
        </button>
      </div>
    </section>

    <!-- Filter and Actions Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-[#ececee] shadow-xs">
      <div class="flex items-center gap-2 flex-wrap">
        <button class="px-3.5 py-1.5 rounded-xl bg-[#064e3b] text-white text-xs font-bold flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm">gavel</span>
          <span>Semua Berkas (8)</span>
        </button>
        <button class="px-3.5 py-1.5 rounded-xl bg-[#f4f4f5] hover:bg-[#ececee] text-[#52525b] text-xs font-medium transition-colors">
          Tier 3: &gt; Rp 15 Jt (5)
        </button>
        <button class="px-3.5 py-1.5 rounded-xl bg-[#f4f4f5] hover:bg-[#ececee] text-[#52525b] text-xs font-medium transition-colors">
          Tier 2: Rp 2,5 Jt - 15 Jt (3)
        </button>
      </div>
      <div class="text-xs font-mono text-[#71717a]">
        Total Nilai Disposisi: <strong class="text-[#09090b] font-bold">Rp 125.800.000</strong>
      </div>
    </div>

    <!-- 8 Detailed Dossier Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      
      <!-- Dossier 1 -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
