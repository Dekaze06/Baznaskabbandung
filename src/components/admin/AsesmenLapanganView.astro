      </div>
    </div>
    <button id="btn-close-survei-form" type="button" class="p-1.5 rounded-control bg-canvas text-fog hover:text-graphite">
      <span class="material-symbols-outlined text-base">close</span>
    </button>
  </div>
  <form id="form-entry-survei" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
    <div>
      <label class="block font-bold text-graphite mb-1">NIK Pemohon (Dukcapil 16 Digit)</label>
      <input type="text" name="nik" placeholder="3204xxxxxxxxxxxx" required class="w-full bg-canvas border border-hairline text-graphite px-3 py-2 rounded-control font-mono focus:border-primary outline-none"/>
    </div>
    <div>
      <label class="block font-bold text-graphite mb-1">Nama Lengkap Kepala Keluarga</label>
      <input type="text" name="nama" placeholder="Sesuai KTP / KK" required class="w-full bg-canvas border border-hairline text-graphite px-3 py-2 rounded-control focus:border-primary outline-none"/>
    </div>
    <div>
      <label class="block font-bold text-graphite mb-1">Nomor Kartu Keluarga (KK)</label>
      <input type="text" name="nokk" placeholder="3204xxxxxxxxxxxx" required class="w-full bg-canvas border border-hairline text-graphite px-3 py-2 rounded-control font-mono focus:border-primary outline-none"/>
    </div>
    <div>
      <label class="block font-bold text-graphite mb-1">Kecamatan (Kab. Bandung)</label>
      <select name="kecamatan" class="w-full bg-canvas border border-hairline text-graphite px-3 py-2 rounded-control focus:border-primary outline-none cursor-pointer">
        <option value="Soreang">Soreang</option>
        <option value="Ciwidey">Ciwidey</option>
        <option value="Pasirjambu">Pasirjambu</option>
        <option value="Rancabali">Rancabali</option>
        <option value="Banjaran">Banjaran</option>
        <option value="Baleendah">Baleendah</option>
        <option value="Majalaya">Majalaya</option>
        <option value="Cileunyi">Cileunyi</option>
        <option value="Pangalengan">Pangalengan</option>
        <option value="Ciparay">Ciparay</option>
      </select>
    </div>
    <div>
      <label class="block font-bold text-graphite mb-1">Desa / Kampung / RT-RW</label>
      <input type="text" name="alamat" placeholder="Kp. Sukamaju RT 01/RW 03" required class="w-full bg-canvas border border-hairline text-graphite px-3 py-2 rounded-control focus:border-primary outline-none"/>
    </div>
