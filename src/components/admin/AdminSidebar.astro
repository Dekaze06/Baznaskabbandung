---
interface Props {
  activeRoute?: string;
}

const { activeRoute = "" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const isModActive = (prefix: string) => {
  if (prefix === '/admin' && (currentPath === '/admin' || currentPath === '')) return true;
  return currentPath.startsWith(prefix);
};

const isSubActive = (path: string) => {
  return currentPath === path;
};
---

<!-- ==================== SIDEBAR ADMIN (SaaS BACKOFFICE) ==================== -->
  <aside id="app-sidebar" class="fixed left-0 top-0 h-screen w-72 bg-white z-50 flex flex-col border-r border-[#ececee] shadow-xs">
    <!-- Brand / Header -->
    <div class="h-20 px-6 flex items-center justify-between border-b border-[#ececee] shrink-0">
      <a href="/admin" class="flex items-center gap-3 min-w-0">
        <img alt="Logo BAZNAS Kabupaten Bandung" class="h-10 w-auto object-contain shrink-0" src="/logo-baznas-navbar.webp" width="128" height="40" loading="eager"/>
        <div class="flex flex-col min-w-0">
          <span class="font-bold text-[15px] tracking-tight leading-tight text-[#064e3b] truncate">BAZNAS Bandung</span>
          <span class="font-mono text-[10px] uppercase tracking-wider text-[#71717a] font-semibold">Panel Admin v2.0</span>
