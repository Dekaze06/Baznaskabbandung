---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Capaian RKAT 2026 - Panel Admin BAZNAS" sectionName="Ringkasan Strategis" pageTitle="Capaian & Realisasi RKAT 2026 (5 Pilar BAZNAS)" activeRoute="command-center/rkat">
  <main class="p-6 lg:p-8 space-y-7">

    <!-- Top Sub-Nav Pills -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Sub navigasi ringkasan eksekutif">
      <a href="/admin/command-center" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        <span>Ikhtisar Eksekutif</span>
      </a>
      <a href="/admin/command-center/tte" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#ff5a00]">signature</span>
        <span>Otorisasi &amp; Disposisi TTE</span>
        <span class="px-1.5 py-0.2 rounded-full bg-[#ff5a00] text-white text-[10px] font-bold">8</span>
      </a>
      <a href="/admin/command-center/radar-wilayah" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">map</span>
        <span>Radar Sebaran 31 Kec.</span>
      </a>
      <a href="/admin/command-center/rkat" class="px-4 py-2 rounded-full text-xs font-bold bg-[#064e3b] text-white flex items-center gap-1.5 shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>Capaian RKAT 2026</span>
      </a>
    </nav>

    <!-- RKAT Summary Banner -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 shadow-xs">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <span class="text-xs text-[#71717a] block">Target Pagu RKAT 2026</span>
          <strong class="text-3xl font-bold text-[#09090b]">Rp 57,50 M</strong>
          <span class="text-xs text-[#71717a] block mt-1">Disahkan Pleno Kemenag RI</span>
        </div>
        <div>
          <span class="text-xs text-[#71717a] block">Realisasi ZIS Terdistribusi</span>
          <strong class="text-3xl font-bold text-[#064e3b]">Rp 48,72 M</strong>
          <span class="text-xs text-[#064e3b] font-semibold block mt-1">84,70% Dari Target</span>
        </div>
        <div>
          <span class="text-xs text-[#71717a] block">Total Penerima Manfaat</span>
          <strong class="text-3xl font-bold text-[#09090b]">43.890 Jiwa</strong>
          <span class="text-xs text-[#71717a] block mt-1">Tersebar di 31 Kecamatan</span>
        </div>
        <div>
          <span class="text-xs text-[#71717a] block">Predikat Kepatuhan Syariah</span>
          <strong class="text-3xl font-bold text-[#064e3b]">KAP WTP</strong>
          <span class="text-xs text-[#064e3b] font-semibold block mt-1">5 Tahun Berturut-turut</span>
        </div>
      </div>
      <div class="mt-6 pt-5 border-t border-[#ececee] space-y-2">
        <div class="flex justify-between text-xs font-semibold">
          <span>Progres Penyaluran RKAT Tahunan: 84.70%</span>
          <span class="font-mono text-[#064e3b]">Sisa Alokasi: Rp 8.780.000.000</span>
        </div>
        <div class="w-full bg-[#f4f4f5] h-3 rounded-full overflow-hidden">
          <div class="bg-[#064e3b] h-full rounded-full" style="width: 84.7%"></div>
        </div>
      </div>
    </section>

    <!-- 5-Pillar Comprehensive Table -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 space-y-4 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
        <div>
          <h2 class="font-bold text-base text-[#09090b]">Rincian Alokasi &amp; Realisasi 5 Pilar Program BAZNAS</h2>
          <p class="text-xs text-[#71717a] mt-0.5">Sesuai Peraturan BAZNAS RI No. 1 Tahun 2016 tentang Tata Cara Pendistribusian &amp; Pendayagunaan Zakat</p>
        </div>
        <span class="px-3 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] font-mono text-xs font-bold border border-[#064e3b]/20">
          Audited SIMBA 3204
        </span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-[#ececee]">
        <table class="w-full text-left text-xs">
          <thead class="bg-[#f8fafc] text-[#71717a] uppercase font-bold text-[10px] tracking-wider border-b border-[#ececee]">
            <tr>
              <th class="py-3.5 px-4">Pilar Program BAZNAS</th>
              <th class="py-3.5 px-4">Fokus Intervensi &amp; Program Utama</th>
              <th class="py-3.5 px-4 text-right">Pagu RKAT (Rp)</th>
              <th class="py-3.5 px-4 text-right">Realisasi (Rp)</th>
              <th class="py-3.5 px-4 text-center">Persentase</th>
              <th class="py-3.5 px-4 text-right">Penerima (Mustahik)</th>
              <th class="py-3.5 px-4 text-center">Status Audit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ececee] bg-white text-[#18181b]">
            <!-- Pilar 1: Bandung Peduli -->
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="py-4 px-4 font-bold text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#064e3b]"></span>
                  <span>Bandung Peduli</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a]">
                Rehabilitasi 340 Rutilahu, Tanggap Bencana Banjir Citarum, Santunan Sembako Lansia Fakir
              </td>
              <td class="py-4 px-4 text-right font-mono font-semibold">18.500.000.000</td>
              <td class="py-4 px-4 text-right font-mono font-bold text-[#064e3b]">15.670.000.000</td>
              <td class="py-4 px-4 text-center font-mono font-bold text-[#064e3b]">84,7%</td>
              <td class="py-4 px-4 text-right font-mono font-semibold">18.420 Jiwa</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Tepat Sasaran</span>
              </td>
            </tr>

            <!-- Pilar 2: Bandung Sehat -->
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="py-4 px-4 font-bold text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#064e3b]"></span>
                  <span>Bandung Sehat</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a]">
                Subsidi Cuci Darah RSUD Otista &amp; Al-Ihsan, Penanganan Stunting 31 Kec, Kursi Roda Adaptif
              </td>
              <td class="py-4 px-4 text-right font-mono font-semibold">8.200.000.000</td>
              <td class="py-4 px-4 text-right font-mono font-bold text-[#064e3b]">7.120.000.000</td>
              <td class="py-4 px-4 text-center font-mono font-bold text-[#064e3b]">86,8%</td>
              <td class="py-4 px-4 text-right font-mono font-semibold">6.890 Jiwa</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Tepat Sasaran</span>
              </td>
            </tr>

            <!-- Pilar 3: Bandung Cerdas -->
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="py-4 px-4 font-bold text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#064e3b]"></span>
                  <span>Bandung Cerdas</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a]">
                Satu Keluarga Satu Sarjana (SKSS), Beasiswa Santri Tahfidz Al-Quran, Pelunasan Tunggakan Ijazah
              </td>
              <td class="py-4 px-4 text-right font-mono font-semibold">9.800.000.000</td>
              <td class="py-4 px-4 text-right font-mono font-bold text-[#064e3b]">8.250.000.000</td>
              <td class="py-4 px-4 text-center font-mono font-bold text-[#064e3b]">84,2%</td>
              <td class="py-4 px-4 text-right font-mono font-semibold">8.120 Siswa</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Tepat Sasaran</span>
              </td>
            </tr>

            <!-- Pilar 4: Bandung Makmur -->
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="py-4 px-4 font-bold text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#064e3b]"></span>
                  <span>Bandung Makmur</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a]">
                Modal Usaha Bengkel Z-Auto, Gerobak Z-Chicken Majalaya, Lumbung Pertanian Kopi Pangalengan
              </td>
              <td class="py-4 px-4 text-right font-mono font-semibold">12.000.000.000</td>
              <td class="py-4 px-4 text-right font-mono font-bold text-[#064e3b]">10.180.000.000</td>
              <td class="py-4 px-4 text-center font-mono font-bold text-[#064e3b]">84,8%</td>
              <td class="py-4 px-4 text-right font-mono font-semibold">3.450 Usaha</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Produktif</span>
              </td>
            </tr>

            <!-- Pilar 5: Bandung Taqwa -->
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="py-4 px-4 font-bold text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#064e3b]"></span>
                  <span>Bandung Taqwa</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a]">
                Iuran BPJS Ketenagakerjaan Marbot Masjid, Bisyarah Guru Ngaji Tradisional, Pembinaan Muallaf
              </td>
              <td class="py-4 px-4 text-right font-mono font-semibold">9.000.000.000</td>
              <td class="py-4 px-4 text-right font-mono font-bold text-[#064e3b]">7.500.000.000</td>
              <td class="py-4 px-4 text-center font-mono font-bold text-[#064e3b]">83,3%</td>
              <td class="py-4 px-4 text-right font-mono font-semibold">7.010 Amil/Dai</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Fisabilillah</span>
              </td>
            </tr>

            <!-- Hak Amil Syar'i (Maks 12.5%) -->
            <tr class="bg-[#f8fafc]/80 font-semibold">
              <td class="py-4 px-4 text-[#09090b]">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-[#d97706]"></span>
                  <span>Hak Kelola Amil (Syar'i)</span>
                </div>
              </td>
              <td class="py-4 px-4 text-[#71717a] italic">
                Operasional 31 UPZ Kecamatan, Honor Surveyor Lapangan, Lisensi SIMBA IT &amp; Audit KAP (Maks 12.5%)
              </td>
              <td class="py-4 px-4 text-right font-mono text-[#09090b]">7.187.500.000</td>
              <td class="py-4 px-4 text-right font-mono text-[#064e3b]">4.336.080.000</td>
              <td class="py-4 px-4 text-center font-mono text-[#064e3b]">8,9% <span class="text-[10px] text-[#71717a] font-normal">(Efisien)</span></td>
              <td class="py-4 px-4 text-right font-mono text-[#09090b]">487 UPZ + Amil</td>
              <td class="py-4 px-4 text-center">
                <span class="px-2.5 py-1 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">Sangat Efisien</span>
              </td>
            </tr>
          </tbody>
          <tfoot class="bg-[#f8fafc] font-bold text-xs border-t-2 border-[#ececee]">
            <tr>
              <td class="py-4 px-4 text-[#09090b]" colspan="2">TOTAL PENYALURAN ZIS RKAT 2026</td>
              <td class="py-4 px-4 text-right font-mono text-[#09090b]">Rp 57.500.000.000</td>
              <td class="py-4 px-4 text-right font-mono text-[#064e3b] text-sm">Rp 48.720.000.000</td>
              <td class="py-4 px-4 text-center font-mono text-[#064e3b] text-sm">84,7%</td>
              <td class="py-4 px-4 text-right font-mono text-[#09090b]">43.890 Jiwa</td>
              <td class="py-4 px-4 text-center">
                <span class="px-3 py-1 rounded-full bg-[#064e3b] text-white text-[10px] font-bold">WTP Audit Ready</span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

  </main>
</AdminLayout>
