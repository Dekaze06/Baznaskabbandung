      { id: "rancaekek", name: "Rancaekek", region: "timur", regionName: "Bandung Timur", desa: "14 Desa/Kel", lat: -6.9682, lng: 107.7612, mustahik: "2.980 KK", dana: "Rp 3.420.000.000", rutilahu: "46 Unit", umkm: "24 Titik", beasiswa: "198 Siswa", highlight: "Kawasan Industri • Kemitraan Zakat Perusahaan" },
      { id: "cileunyi", name: "Cileunyi", region: "timur", regionName: "Bandung Timur", desa: "6 Desa", lat: -6.9381, lng: 107.7412, mustahik: "2.120 KK", dana: "Rp 2.480.000.000", rutilahu: "31 Unit", umkm: "17 Titik", beasiswa: "145 Siswa", highlight: "Simpul Timur • Rumah Singgah Pasien Dhuafa" },
      { id: "cilengkrang", name: "Cilengkrang", region: "timur", regionName: "Bandung Timur", desa: "6 Desa", lat: -6.8912, lng: 107.7189, mustahik: "1.280 KK", dana: "Rp 1.490.000.000", rutilahu: "19 Unit", umkm: "10 Titik", beasiswa: "88 Siswa", highlight: "Lereng Manglayang • Bantuan Kelompok Tani" },
      { id: "cimenyan", name: "Cimenyan", region: "timur", regionName: "Bandung Timur", desa: "9 Desa/Kel", lat: -6.8712, lng: 107.6689, mustahik: "1.610 KK", dana: "Rp 1.870.000.000", rutilahu: "23 Unit", umkm: "12 Titik", beasiswa: "108 Siswa", highlight: "Bandung Utara • Bantuan Sembako Warga Bukit" },
      { id: "solokanjero", name: "Solokanjero", region: "timur", regionName: "Bandung Timur", desa: "7 Desa", lat: -7.0212, lng: 107.7312, mustahik: "1.840 KK", dana: "Rp 2.080.000.000", rutilahu: "28 Unit", umkm: "14 Titik", beasiswa: "125 Siswa", highlight: "Koridor Majalaya • Pelatihan Vokasi Kerja Dhuafa" }
    ];

    let map = null;
    let markersLayer = null;
    let activeMarker = null;

    function updateDetails(k) {
      const elName = document.getElementById("detailKecamatanName");
      const elRegion = document.getElementById("detailKecamatanRegion");
      const elDesa = document.getElementById("detailKecamatanDesa");
      const elHighlight = document.getElementById("detailKecamatanHighlight");
      const elDana = document.getElementById("detailKecamatanDana");
      const elMustahik = document.getElementById("detailKecamatanMustahik");
      const elRutilahu = document.getElementById("detailKecamatanRutilahu");
      const elZAuto = document.getElementById("detailKecamatanZAuto");
      const elBeasiswa = document.getElementById("detailKecamatanBeasiswa");
      const elGisTitle = document.getElementById("gisActiveTitle");
      const elGisSub = document.getElementById("gisActiveSub");

      if (elName) elName.textContent = "Kecamatan " + k.name;
      if (elRegion) elRegion.textContent = k.regionName;
      if (elDesa) elDesa.textContent = k.desa;
      if (elHighlight) elHighlight.textContent = k.highlight;
      if (elDana) elDana.textContent = k.dana;
      if (elMustahik) elMustahik.textContent = k.mustahik;
      if (elRutilahu) elRutilahu.textContent = k.rutilahu;
      if (elZAuto) elZAuto.textContent = k.umkm;
      if (elBeasiswa) elBeasiswa.textContent = k.beasiswa;
      if (elGisTitle) elGisTitle.textContent = "Kecamatan " + k.name;
      if (elGisSub) elGisSub.textContent = k.mustahik + " Mustahik • " + k.dana;

      // Sync select dropdown if not already synced
      const selectEl = document.getElementById("kecamatanSelect");
      if (selectEl && selectEl.value !== k.id) {
        selectEl.value = k.id;
      }
    }

    function populateSelect(region = "all") {
      const selectEl = document.getElementById("kecamatanSelect");
      if (!selectEl) return;
      const currentVal = selectEl.value;
      selectEl.innerHTML = '<option value="">Pilih Kecamatan (31)...</option>';
      
      const filtered = region === "all" ? KECAMATAN_31 : KECAMATAN_31.filter(k => k.region === region);
      filtered.forEach(k => {
        const opt = document.createElement("option");
        opt.value = k.id;
        opt.textContent = k.name + " (" + k.regionName + ")";
        selectEl.appendChild(opt);
      });

      if (currentVal && filtered.some(k => k.id === currentVal)) {
        selectEl.value = currentVal;
      }
    }

    function renderMarkers(region = "all") {
      if (!map || !window.L) return;
      if (markersLayer) markersLayer.clearLayers();
      markersLayer = L.layerGroup().addTo(map);

      const filtered = region === "all" ? KECAMATAN_31 : KECAMATAN_31.filter(k => k.region === region);
      const bounds = [];

      filtered.forEach(k => {
        bounds.push([k.lat, k.lng]);
        const customIcon = L.divIcon({
          className: "baznas-pin-marker",
          html: `<div class="baznas-pin-inner" id="pin-${k.id}" title="${k.name}"><span>${k.name.substring(0, 2).toUpperCase()}</span></div>`,
          iconSize: [26, 26],
          iconAnchor: [13, 13]
        });

        const marker = L.marker([k.lat, k.lng], { icon: customIcon });
        marker.bindPopup(`
          <div class="space-y-1">
            <div class="text-[10px] font-bold text-[#064e3b] uppercase tracking-wider">${k.regionName}</div>
            <div class="text-sm font-bold text-[#09090b]">Kecamatan ${k.name}</div>
            <div class="text-xs text-[#52525b]">${k.highlight}</div>
            <div class="pt-1.5 border-t border-[#e4e4e7] flex justify-between gap-3 text-xs">
              <span class="text-[#71717a]">Penyaluran:</span>
              <strong class="text-[#064e3b]">${k.dana}</strong>
            </div>
            <div class="flex justify-between gap-3 text-xs">
              <span class="text-[#71717a]">Mustahik:</span>
              <strong class="text-[#09090b]">${k.mustahik}</strong>
            </div>
          </div>
        `, { closeButton: false, offset: [0, -10] });

        marker.on("click", () => {
          updateDetails(k);
          highlightPin(k.id);
        });

        markersLayer.addLayer(marker);
      });

      if (bounds.length > 0 && region !== "all") {
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });
      }
    }

    function highlightPin(id) {
      document.querySelectorAll(".baznas-pin-inner").forEach(el => el.classList.remove("active"));
      const targetPin = document.getElementById("pin-" + id);
      if (targetPin) targetPin.classList.add("active");
    }

    function selectKecamatanById(id) {
      const k = KECAMATAN_31.find(item => item.id === id);
      if (!k || !map) return;
      updateDetails(k);
      map.flyTo([k.lat, k.lng], 13, { duration: 1.2 });
      highlightPin(id);
    }

    function initMap() {
      const mapContainer = document.getElementById("penyaluranMap");
      if (!mapContainer || !window.L) return;

      // Initialize Leaflet Map centered on Kabupaten Bandung
      map = L.map("penyaluranMap", {
        center: [-7.04, 107.62],
        zoom: 11,
        zoomControl: true,
        scrollWheelZoom: false
      });

      // CartoDB Voyager tiles for crisp editorial aesthetics
      L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png", {
        attribution: '&copy; <a href="https://carto.com/">CARTO</a> &copy; OpenStreetMap',
        subdomains: "abcd",
        maxZoom: 19
      }).addTo(map);

      populateSelect("all");
      renderMarkers("all");

      // Default select Soreang
      updateDetails(KECAMATAN_31[0]);
      highlightPin("soreang");

      // Dropdown change listener
      const selectEl = document.getElementById("kecamatanSelect");
      if (selectEl) {
        selectEl.addEventListener("change", (e) => {
          const val = e.target.value;
          if (val) selectKecamatanById(val);
        });
      }

      // Region Filter Buttons
      const filterBtns = document.querySelectorAll(".filter-reg-btn");
      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => {
            b.classList.remove("active", "bg-emerald-deep", "text-white");
            b.classList.add("bg-canvas", "text-steel");
          });
          btn.classList.add("active", "bg-emerald-deep", "text-white");
          btn.classList.remove("bg-canvas", "text-steel");

          const reg = btn.getAttribute("data-region") || "all";
          populateSelect(reg);
          renderMarkers(reg);
        });
      });

      window.addEventListener("resize", () => {
        if (map) map.invalidateSize();
      });
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
      setTimeout(initMap, 200);
    } else {
      document.addEventListener("DOMContentLoaded", () => setTimeout(initMap, 200));
    }

    // Verify BSZ Global Helper
    window.verifyBsz = function() {
      const bszNum = document.getElementById("bszNumber")?.value;
      const bszRes = document.getElementById("bszResultCard");
      if (bszRes) {
        bszRes.classList.remove("hidden");
        bszRes.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    };
  })();
</script>
