---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout 
  title="Portal Zakat, Infak & Sedekah (ZIS) - BAZNAS Kabupaten Bandung"
  description="Pusat layanan terpadu ZIS resmi BAZNAS Kabupaten Bandung. Perhitungan zakat otomatis, nishab syar'i terkini, rekening resmi bank syariah, dan transparansi penyaluran 5 pilar program."
>
  <main class="flex-1 bg-[#fcfcfc]">
    <!-- HERO SECTION -->
    <section class="border-b border-[#e4e4e7] bg-white py-12 lg:py-16">
      <div class="max-w-[1400px] mx-auto px-6">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-[#71717a] font-medium mb-6">
          <a href="/" class="hover:text-[#064e3b] transition-colors">Beranda</a>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span>Program</span>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-[#09090b] font-semibold">Zakat, Infak &amp; Sedekah</span>
        </nav>

        <!-- Hero Grid (Text + Editorial Visual) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Left Column: Copy & Actions -->
          <div class="lg:col-span-7 space-y-6">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#09090b] tracking-tight leading-[1.12]">
              Portal Terpadu Zakat, Infak &amp; Sedekah
            </h1>
            
            <p class="text-sm sm:text-base text-[#52525b] leading-relaxed max-w-2xl font-normal">
              Pusat edukasi fikih, kalkulasi nishab presisi, dan penunaian donasi syariah resmi di Kabupaten Bandung. Setiap amanah dikelola transparan dengan prinsip 3A (Aman Syar'i, Aman Regulasi, Aman NKRI) dan disertai Bukti Setor Zakat (BSZ) digital sah pengurang pajak bruto.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <button onclick="window.openQuickZisModal?.()" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-semibold transition-all shadow-sm">
                <span class="material-symbols-outlined text-base">payments</span>
                <span>Tunaikan ZIS Sekarang</span>
              </button>
              <a href="#kalkulator-cepat" class="inline-flex items-center gap-2 px-5 py-3.5 rounded-2xl bg-[#f4f4f5] hover:bg-[#e4e4e7] text-[#09090b] text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-base text-[#064e3b]">calculate</span>
                <span>Hitung Zakat Kilat</span>
              </a>
              <a href="#rekening-zis" class="inline-flex items-center gap-2 px-5 py-3.5 rounded-2xl bg-white border border-[#e4e4e7] hover:bg-[#f4f4f5] text-[#09090b] text-xs font-semibold transition-all">
                <span class="material-symbols-outlined text-base text-[#064e3b]">account_balance</span>
                <span>Rekening Bank Resmi</span>
              </a>
            </div>

            <!-- Trust Badges Strip (Monochromatic) -->
            <div class="pt-4 border-t border-[#f4f4f5] flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-[#71717a]">
              <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-[#064e3b]">verified</span>
                <span>Opini KAP WTP 5 Tahun</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-[#064e3b]">gavel</span>
                <span>UU No. 23 Tahun 2011</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-[#064e3b]">receipt_long</span>
                <span>Sah Pengurang PPh 21</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Editorial Hero Image -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-3xl overflow-hidden border border-[#e4e4e7] bg-[#f4f4f5] shadow-lg">
              <img 
                src="/images/zis-hero.webp" 
                alt="Penyaluran zakat dan pemberdayaan mustahik BAZNAS Kabupaten Bandung" 
                class="w-full h-[380px] sm:h-[440px] object-cover object-center"
                loading="eager"
                width="800"
                height="600"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              
              <!-- Floating Caption Card -->
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-white/40 text-xs shadow-sm">
                <span class="font-bold text-[#09090b] block">Distribusi Tepat Sasaran</span>
                <span class="text-[#52525b] text-[11px] block mt-0.5">Menjangkau 48.910 penerima manfaat di 31 kecamatan Kabupaten Bandung.</span>
              </div>
            </div>
          </div>

        </div>

        <!-- 4 Minimalist Statistics Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-12 p-6 bg-[#fafafa] rounded-3xl border border-[#e4e4e7]">
          <div class="space-y-1">
            <span class="text-xs text-[#71717a] font-medium block">Total Realisasi Penyaluran</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#064e3b]">Rp 20,05 M</div>
            <span class="text-[11px] text-[#71717a] block">87.2% dari Target RKAT</span>
          </div>
          <div class="space-y-1">
            <span class="text-xs text-[#71717a] font-medium block">Penerima Manfaat</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#09090b]">48.910 Jiwa</div>
            <span class="text-[11px] text-[#71717a] block">Tersebar di 31 Kecamatan</span>
          </div>
          <div class="space-y-1">
            <span class="text-xs text-[#71717a] font-medium block">Standar Nisab Emas</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#09090b]">Rp 82,35 Jt</div>
            <span class="text-[11px] text-[#71717a] block">Setara 85 gr Emas Murni / thn</span>
          </div>
          <div class="space-y-1">
            <span class="text-xs text-[#71717a] font-medium block">Audit &amp; Kepatuhan</span>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-[#064e3b]">WTP &amp; Akreditasi A</div>
            <span class="text-[11px] text-[#71717a] block">Kemenag RI &amp; BAZNAS RI</span>
          </div>
        </div>

      </div>
    </section>

    <!-- MAIN BODY CONTAINER -->
    <div class="max-w-[1400px] mx-auto px-6 py-14 space-y-16">

      <!-- SECTION 1: KLASIFIKASI SYARIAH (ZAKAT, INFAK, SEDEKAH) -->
      <section class="space-y-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#09090b] tracking-tight">Ketentuan Syariah ZIS</h2>
          <p class="text-xs sm:text-sm text-[#71717a] mt-1">Panduan praktis fikih untuk membedakan hukum, nishab, dan alokasi dana</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Card Zakat -->
          <div class="bg-white rounded-3xl border border-[#e4e4e7] p-7 flex flex-col justify-between space-y-4 hover:border-[#a1a1aa] transition-colors">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-[#f4f4f5] text-[#064e3b] flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">balance</span>
              </div>
              <h3 class="text-lg font-bold text-[#09090b]">Zakat (Kewajiban Pokok)</h3>
              <p class="text-xs text-[#52525b] leading-relaxed">
                Rukun Islam ke-3 yang wajib dikeluarkan oleh setiap muslim yang memenuhi kriteria nishab dan haul untuk menyucikan jiwa dan harta.
              </p>
              <ul class="space-y-2 text-xs text-[#52525b] border-t border-[#f4f4f5] pt-3">
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Zakat Penghasilan:</strong> 2.5% dari pendapatan bersih rutin bulanan.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Zakat Maal:</strong> 2.5% dari tabungan, emas, atau aset mengendap 1 tahun.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Zakat Fitrah:</strong> Rp 40.000 / 2.5 kg beras per jiwa di bulan Ramadhan.</span>
                </li>
              </ul>
            </div>
            <div class="pt-3 border-t border-[#f4f4f5]">
              <span class="text-[11px] font-mono text-[#71717a] block">Alokasi: Wajib disalurkan khusus kepada 8 Asnaf</span>
            </div>
          </div>

          <!-- Card Infak -->
          <div class="bg-white rounded-3xl border border-[#e4e4e7] p-7 flex flex-col justify-between space-y-4 hover:border-[#a1a1aa] transition-colors">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-[#f4f4f5] text-[#064e3b] flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">volunteer_activism</span>
              </div>
              <h3 class="text-lg font-bold text-[#09090b]">Infak (Kemaslahatan Sosial)</h3>
              <p class="text-xs text-[#52525b] leading-relaxed">
                Pengeluaran harta secara sukarela tanpa batasan nishab dan haul untuk membiayai program sosial, pemberdayaan ekonomi, dan sarana dakwah.
              </p>
              <ul class="space-y-2 text-xs text-[#52525b] border-t border-[#f4f4f5] pt-3">
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Infak Produktif:</strong> Bantuan modal usaha dan sarana kerja mustahik.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Infak Sarana Dakwah:</strong> Pembangunan madrasah &amp; masjid perbatasan.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Infak Subuh:</strong> Sedekah rutin harian untuk pembuka keberkahan.</span>
                </li>
              </ul>
            </div>
            <div class="pt-3 border-t border-[#f4f4f5]">
              <span class="text-[11px] font-mono text-[#71717a] block">Alokasi: Fleksibel untuk kemaslahatan masyarakat</span>
            </div>
          </div>

          <!-- Card Sedekah & Fidyah -->
          <div class="bg-white rounded-3xl border border-[#e4e4e7] p-7 flex flex-col justify-between space-y-4 hover:border-[#a1a1aa] transition-colors">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-[#f4f4f5] text-[#064e3b] flex items-center justify-center">
                <span class="material-symbols-outlined text-xl">handshake</span>
              </div>
              <h3 class="text-lg font-bold text-[#09090b]">Sedekah &amp; Fidyah</h3>
              <p class="text-xs text-[#52525b] leading-relaxed">
                Kebaikan non-materiil maupun materiil, serta kewajiban tebusan bagi yang berhalangan puasa secara permanen sesuai ketentuan fikih.
              </p>
              <ul class="space-y-2 text-xs text-[#52525b] border-t border-[#f4f4f5] pt-3">
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Fidyah Puasa:</strong> Rp 30.000 / hari / jiwa mustahik dhuafa.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Kafarat:</strong> Pengganti tebusan sumpah atau pelanggaran syar'i.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="material-symbols-outlined text-sm text-[#064e3b] mt-0.5">check</span>
                  <span><strong>Sedekah Darurat:</strong> Bantuan logistik bencana alam dan musibah.</span>
                </li>
              </ul>
            </div>
            <div class="pt-3 border-t border-[#f4f4f5]">
              <span class="text-[11px] font-mono text-[#71717a] block">Alokasi: Disalurkan dalam bentuk pangan &amp; santunan langsung</span>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 2: KALKULATOR ZIS KILAT (INTERACTIVE WIDGET) -->
      <section id="kalkulator-cepat" class="bg-white rounded-3xl border border-[#e4e4e7] p-8 lg:p-10 shadow-sm space-y-8 scroll-mt-24">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#f4f4f5] pb-6">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#09090b] tracking-tight">Kalkulator ZIS Interaktif</h2>
            <p class="text-xs sm:text-sm text-[#71717a] mt-1">Hitung kewajiban zakat profesi dan zakat maal Anda secara presisi dalam hitungan detik</p>
          </div>
          <div class="flex items-center gap-1.5 p-1 bg-[#f4f4f5] rounded-xl text-xs font-semibold">
            <button id="calcTabProfesi" class="px-4 py-2 rounded-lg bg-white text-[#09090b] shadow-xs transition-all">Zakat Profesi</button>
            <button id="calcTabMaal" class="px-4 py-2 rounded-lg text-[#71717a] hover:text-[#09090b] transition-all">Zakat Maal</button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Input Form Column -->
          <div class="lg:col-span-7 space-y-5">
            
            <!-- Form Profesi -->
            <div id="calcPanelProfesi" class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Penghasilan Bulanan (Gaji Pokok &amp; Tunjangan Tetap)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                  <input type="number" id="inProfesiGaji" value="10000000" min="0" step="500000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-3 pl-10 pr-4 text-sm font-mono font-bold text-[#09090b] outline-none transition-all" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Bonus / Penghasilan Lainnya (Opsional)</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                    <input type="number" id="inProfesiBonus" value="0" min="0" step="100000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-2.5 pl-10 pr-4 text-xs font-mono font-bold text-[#09090b] outline-none transition-all" />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Pengeluaran Pokok Bulanan (Kebutuhan Dasar)</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                    <input type="number" id="inProfesiPengeluaran" value="2500000" min="0" step="100000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-2.5 pl-10 pr-4 text-xs font-mono font-bold text-[#09090b] outline-none transition-all" />
                  </div>
                </div>
              </div>
              <div class="p-3 bg-[#fafafa] border border-[#e4e4e7] rounded-xl text-[11px] text-[#71717a] flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-[#064e3b]">info</span>
                <span>Standar nishab zakat profesi per bulan: <strong class="text-[#09090b]">Rp 6.862.500</strong> (1/12 dari nishab 85 gr emas).</span>
              </div>
            </div>

            <!-- Form Maal -->
            <div id="calcPanelMaal" class="space-y-4 hidden">
              <div>
                <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Saldo Tabungan / Deposito / Giro</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                  <input type="number" id="inMaalTabungan" value="95000000" min="0" step="1000000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-3 pl-10 pr-4 text-sm font-mono font-bold text-[#09090b] outline-none transition-all" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Nilai Emas, Perak &amp; Investasi</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                    <input type="number" id="inMaalEmas" value="0" min="0" step="1000000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-2.5 pl-10 pr-4 text-xs font-mono font-bold text-[#09090b] outline-none transition-all" />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-bold text-[#09090b] uppercase tracking-wider mb-1.5">Hutang Jatuh Tempo (Pengurang)</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-[#71717a]">Rp</span>
                    <input type="number" id="inMaalHutang" value="0" min="0" step="500000" class="w-full bg-[#fafafa] border border-[#e4e4e7] focus:border-[#064e3b] focus:bg-white rounded-xl py-2.5 pl-10 pr-4 text-xs font-mono font-bold text-[#09090b] outline-none transition-all" />
                  </div>
                </div>
              </div>
              <div class="p-3 bg-[#fafafa] border border-[#e4e4e7] rounded-xl text-[11px] text-[#71717a] flex items-center gap-2">
                <span class="material-symbols-outlined text-sm text-[#064e3b]">info</span>
                <span>Standar nishab zakat maal tahunan: <strong class="text-[#09090b]">Rp 82.350.000</strong> (setara 85 gr emas yang mengendap 1 haul).</span>
              </div>
            </div>

          </div>

          <!-- Result Display Card -->
          <div class="lg:col-span-5 bg-[#fafafa] border border-[#e4e4e7] rounded-3xl p-6 sm:p-7 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
              <span class="text-xs font-bold text-[#09090b]">STATUS PERHITUNGAN</span>
              <span id="calcStatusBadge" class="px-2.5 py-1 rounded-full bg-white border border-[#e4e4e7] text-[#064e3b] font-bold text-[11px]">Wajib Zakat</span>
            </div>

            <div class="space-y-1">
              <span class="text-xs text-[#71717a] block">Kewajiban Zakat yang Harus Ditunaikan:</span>
              <div id="calcResultNominal" class="text-3xl sm:text-4xl font-extrabold font-mono text-[#064e3b]">
                Rp 187.500
              </div>
              <span id="calcResultPeriod" class="text-[11px] text-[#71717a] block">Per bulan (Kadar zakat 2.5%)</span>
            </div>

            <div class="space-y-2 text-xs border-t border-[#e4e4e7] pt-4 text-[#52525b]">
              <div class="flex justify-between">
                <span>Total Harta / Pendapatan:</span>
                <strong id="calcSummaryHarta" class="font-mono text-[#09090b]">Rp 10.000.000</strong>
              </div>
              <div class="flex justify-between">
                <span>Pengurang Pokok / Hutang:</span>
                <strong id="calcSummaryPengurang" class="font-mono text-[#09090b]">Rp 2.500.000</strong>
              </div>
              <div class="flex justify-between">
                <span>Basis Perhitungan Bersih:</span>
                <strong id="calcSummaryBersih" class="font-mono text-[#064e3b]">Rp 7.500.000</strong>
              </div>
            </div>

            <div class="pt-2 flex flex-col gap-2.5">
              <button id="btnTunaikanHasil" class="w-full py-3.5 rounded-2xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-semibold transition-all flex items-center justify-center gap-2 shadow-xs">
                <span class="material-symbols-outlined text-base">payments</span>
                <span>Tunaikan Nominal Ini Sekarang</span>
              </button>
              <a href="/layanan/kalkulator" class="w-full py-2.5 text-center text-xs font-semibold text-[#064e3b] hover:underline">
                Buka Kalkulator Zakat Lengkap (Emas, Saham &amp; Fidyah) →
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 3: 5 PILAR PROGRAM PENDAYAGUNAAN (DENGAN GAMBAR EDITORIAL KONTEKSTUAL) -->
      <section class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#09090b] tracking-tight">5 Program Unggulan Penyaluran ZIS</h2>
            <p class="text-xs sm:text-sm text-[#71717a] mt-1">Distribusi terencana dan terukur untuk mentransformasi mustahik menjadi muzaki mandiri</p>
          </div>
          <a href="/dashboard/penyaluran" class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] hover:underline">
            <span>Peta Sebaran 31 Kecamatan</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- 1. Bandung Makmur (Dengan Foto UMKM Riil) -->
