  <script is:inline>
    // Search UPZ
    document.getElementById('search-upz')?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll('.upz-card').forEach(card => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(q) ? '' : 'none';
      });
    });

    // Form jemput submit
    document.getElementById('form-jemput')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = document.getElementById('jemput-nama')?.value;
      const tgl = document.getElementById('jemput-tanggal')?.value;
      window.showAppToast?.(`Alhamdulillah! Jadwal jemput zakat untuk Bapak/Ibu ${nama} pada tanggal ${tgl} telah dicatat. Tim amil akan menghubungi via WhatsApp.`, 'local_shipping');
      e.target.reset();
    });
  </script>
