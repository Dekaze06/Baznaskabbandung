  <!-- Interactive Quick Calculator Script -->
  <script is:inline>
    (function initZisCalculator() {
      const NISAB_BULANAN = 6862500; // Rp 82.350.000 / 12
      const NISAB_TAHUNAN = 82350000;

      let currentMode = 'profesi'; // 'profesi' | 'maal'

      const tabProfesi = document.getElementById('calcTabProfesi');
      const tabMaal = document.getElementById('calcTabMaal');
      const panelProfesi = document.getElementById('calcPanelProfesi');
      const panelMaal = document.getElementById('calcPanelMaal');

      const inGaji = document.getElementById('inProfesiGaji');
      const inBonus = document.getElementById('inProfesiBonus');
      const inPengeluaran = document.getElementById('inProfesiPengeluaran');

      const inTabungan = document.getElementById('inMaalTabungan');
      const inEmas = document.getElementById('inMaalEmas');
      const inHutang = document.getElementById('inMaalHutang');

      const statusBadge = document.getElementById('calcStatusBadge');
      const resultNominal = document.getElementById('calcResultNominal');
      const resultPeriod = document.getElementById('calcResultPeriod');
      const summaryHarta = document.getElementById('calcSummaryHarta');
      const summaryPengurang = document.getElementById('calcSummaryPengurang');
      const summaryBersih = document.getElementById('calcSummaryBersih');
      const btnTunaikanHasil = document.getElementById('btnTunaikanHasil');

      function formatRupiah(num) {
        return 'Rp ' + Math.max(0, Math.round(num)).toLocaleString('id-ID');
      }

      function calculate() {
        if (currentMode === 'profesi') {
          const gaji = parseFloat(inGaji?.value || 0);
          const bonus = parseFloat(inBonus?.value || 0);
          const pengeluaran = parseFloat(inPengeluaran?.value || 0);

          const totalBruto = gaji + bonus;
          const totalBersih = Math.max(0, totalBruto - pengeluaran);

          if (summaryHarta) summaryHarta.textContent = formatRupiah(totalBruto);
          if (summaryPengurang) summaryPengurang.textContent = formatRupiah(pengeluaran);
          if (summaryBersih) summaryBersih.textContent = formatRupiah(totalBersih);

          if (totalBersih >= NISAB_BULANAN) {
            const zakat = totalBersih * 0.025;
            if (statusBadge) {
              statusBadge.textContent = 'Wajib Zakat';
              statusBadge.className = 'px-2.5 py-1 rounded-full bg-white border border-[#e4e4e7] text-[#064e3b] font-bold text-[11px]';
            }
            if (resultNominal) resultNominal.textContent = formatRupiah(zakat);
            if (resultPeriod) resultPeriod.textContent = 'Per bulan (Kadar zakat 2.5%)';
            if (btnTunaikanHasil) {
              btnTunaikanHasil.onclick = () => {
                window.openQuickZisModal?.();
                const typeInput = document.getElementById('app-zis-type');
                const amtInput = document.getElementById('app-zis-amount');
                if (typeInput) typeInput.value = 'Zakat Penghasilan / Profesi';
                if (amtInput) amtInput.value = Math.round(zakat);
              };
            }
          } else {
            if (statusBadge) {
              statusBadge.textContent = 'Belum Capai Nisab';
              statusBadge.className = 'px-2.5 py-1 rounded-full bg-[#f4f4f5] text-[#71717a] font-bold text-[11px]';
            }
            if (resultNominal) resultNominal.textContent = 'Rp 0';
            if (resultPeriod) resultPeriod.textContent = 'Dianjurkan berinfak sukarela';
            if (btnTunaikanHasil) {
              btnTunaikanHasil.onclick = () => {
                window.openQuickZisModal?.();
                const typeInput = document.getElementById('app-zis-type');
                if (typeInput) typeInput.value = 'Infak / Sedekah Program BAZNAS Peduli';
              };
            }
          }
        } else {
          // Mode Maal
          const tabungan = parseFloat(inTabungan?.value || 0);
          const emas = parseFloat(inEmas?.value || 0);
          const hutang = parseFloat(inHutang?.value || 0);

          const totalHarta = tabungan + emas;
          const totalBersih = Math.max(0, totalHarta - hutang);

          if (summaryHarta) summaryHarta.textContent = formatRupiah(totalHarta);
          if (summaryPengurang) summaryPengurang.textContent = formatRupiah(hutang);
          if (summaryBersih) summaryBersih.textContent = formatRupiah(totalBersih);

          if (totalBersih >= NISAB_TAHUNAN) {
            const zakat = totalBersih * 0.025;
            if (statusBadge) {
              statusBadge.textContent = 'Wajib Zakat Maal';
              statusBadge.className = 'px-2.5 py-1 rounded-full bg-white border border-[#e4e4e7] text-[#064e3b] font-bold text-[11px]';
            }
            if (resultNominal) resultNominal.textContent = formatRupiah(zakat);
            if (resultPeriod) resultPeriod.textContent = 'Per tahun haul (Kadar zakat 2.5%)';
            if (btnTunaikanHasil) {
              btnTunaikanHasil.onclick = () => {
                window.openQuickZisModal?.();
                const typeInput = document.getElementById('app-zis-type');
                const amtInput = document.getElementById('app-zis-amount');
                if (typeInput) typeInput.value = 'Zakat Maal (Tabungan / Emas)';
                if (amtInput) amtInput.value = Math.round(zakat);
              };
            }
          } else {
            if (statusBadge) {
              statusBadge.textContent = 'Belum Capai Nisab (Rp 82,35 Jt)';
              statusBadge.className = 'px-2.5 py-1 rounded-full bg-[#f4f4f5] text-[#71717a] font-bold text-[11px]';
            }
            if (resultNominal) resultNominal.textContent = 'Rp 0';
            if (resultPeriod) resultPeriod.textContent = 'Dianjurkan berinfak sukarela';
            if (btnTunaikanHasil) {
              btnTunaikanHasil.onclick = () => {
                window.openQuickZisModal?.();
                const typeInput = document.getElementById('app-zis-type');
                if (typeInput) typeInput.value = 'Infak / Sedekah Program BAZNAS Peduli';
              };
            }
          }
        }
      }

      tabProfesi?.addEventListener('click', () => {
        currentMode = 'profesi';
        tabProfesi.className = 'px-4 py-2 rounded-lg bg-white text-[#09090b] shadow-xs transition-all';
        tabMaal.className = 'px-4 py-2 rounded-lg text-[#71717a] hover:text-[#09090b] transition-all';
        panelProfesi?.classList.remove('hidden');
        panelMaal?.classList.add('hidden');
        calculate();
      });

      tabMaal?.addEventListener('click', () => {
        currentMode = 'maal';
        tabMaal.className = 'px-4 py-2 rounded-lg bg-white text-[#09090b] shadow-xs transition-all';
        tabProfesi.className = 'px-4 py-2 rounded-lg text-[#71717a] hover:text-[#09090b] transition-all';
        panelMaal?.classList.remove('hidden');
        panelProfesi?.classList.add('hidden');
        calculate();
      });

      [inGaji, inBonus, inPengeluaran, inTabungan, inEmas, inHutang].forEach(el => {
        el?.addEventListener('input', calculate);
      });

      calculate();
    })();
  </script>
</PublicLayout>
