        </div>
        <div class="flex items-center justify-between pt-2 border-t border-[#ececee]">
          <span class="text-[11px] text-[#71717a]">Asesor: Ahmad Fauzi • Rekomendasi Layak</span>
          <button type="button" data-action="open-tte" class="px-3.5 py-1.5 rounded-xl bg-[#064e3b] text-white text-xs font-semibold flex items-center gap-1 hover:bg-[#006a4e]">
