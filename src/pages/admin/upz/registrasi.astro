---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Registrasi & SK UPZ - Panel Admin BAZNAS" sectionName="Jaringan Penghimpunan" pageTitle="Registrasi & Penerbitan SK UPZ Baru" activeRoute="upz/registrasi">
  <main class="p-6 lg:p-8 space-y-7">

    <!-- Top Sub-Nav Pills for Module 4 -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Sub navigasi UPZ">
      <a href="/admin/upz" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        <span>Ikhtisar UPZ</span>
      </a>
      <a href="/admin/upz/direktori" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">folder_shared</span>
        <span>Direktori 487 UPZ</span>
        <span class="px-1.5 py-0.2 rounded-full bg-[#ecfdf5] text-[#064e3b] text-[10px] font-bold">487</span>
      </a>
      <a href="/admin/upz/registrasi" class="px-4 py-2 rounded-full text-xs font-bold bg-[#064e3b] text-white flex items-center gap-1.5 shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-sm">domain_add</span>
        <span>Registrasi &amp; SK UPZ</span>
      </a>
      <a href="/admin/upz/setoran" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">cloud_upload</span>
        <span>Pemrosesan Setoran ASN</span>
      </a>
      <a href="/admin/upz/hak-kelola" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">price_check</span>
        <span>Bagi Hasil Hak Amil 12.5%</span>
      </a>
    </nav>

    <!-- Header Description Card -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">domain_add</span>
        </div>
        <div>
          <h1 class="text-lg font-bold text-[#09090b]">Penerbitan SK &amp; Virtual Account UPZ Terpadu</h1>
          <p class="text-xs text-[#71717a] mt-0.5">Formulir pendaftaran unit baru, pembuatan SK resmi Ketua BAZNAS, dan pembuatan nomor VA otomatis</p>
        </div>
      </div>
      <div class="font-mono text-xs bg-[#f4f4f5] px-3.5 py-2 rounded-xl border border-[#ececee]">
        Format SK: <strong class="text-[#064e3b] font-bold">451.12/SK-UPZ/BAZNAS-BDG/X/2026</strong>
      </div>
    </section>

    <!-- Registration Form Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-7">
      
      <!-- Form Input (8 Cols) -->
      <section class="lg:col-span-8 bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 space-y-6 shadow-xs">
        <h2 class="text-base font-bold text-[#09090b] pb-2 border-b border-[#ececee] flex items-center gap-2">
          <span class="material-symbols-outlined text-base text-[#064e3b]">edit_note</span>
          <span>Formulir Permohonan Pembentukan UPZ</span>
        </h2>

        <form class="space-y-4 text-xs" onsubmit="event.preventDefault(); alert('Registrasi UPZ berhasil disubmit! Nomor SK dan Virtual Account diterbitkan.');">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="font-bold text-[#09090b] block mb-1">Nama Unit / Instansi / DKM:</label>
              <input type="text" placeholder="Contoh: UPZ DKM Masjid Al-Muhajirin Soreang" class="w-full px-3.5 py-2.5 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-medium focus:outline-none focus:border-[#064e3b]" required/>
            </div>
            <div>
              <label class="font-bold text-[#09090b] block mb-1">Kategori UPZ:</label>
              <select class="w-full px-3.5 py-2.5 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-semibold focus:outline-none focus:border-[#064e3b]">
                <option value="kecamatan">UPZ Kecamatan (31 Wilayah)</option>
                <option value="dinas">UPZ Dinas / OPD Pemkab Bandung</option>
                <option value="sekolah">UPZ Sekolah / Korwil Disdik</option>
                <option value="masjid" selected>UPZ DKM Masjid Jami / Besar</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="font-bold text-[#09090b] block mb-1">Wilayah Kecamatan:</label>
              <select class="w-full px-3.5 py-2.5 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-semibold focus:outline-none focus:border-[#064e3b]">
                <option value="soreang">Kec. Soreang</option>
                <option value="ciwidey">Kec. Ciwidey</option>
                <option value="pasirjambu">Kec. Pasirjambu</option>
                <option value="pangalengan">Kec. Pangalengan</option>
                <option value="baleendah">Kec. Baleendah</option>
                <option value="banjaran">Kec. Banjaran</option>
                <option value="majalaya">Kec. Majalaya</option>
                <option value="cicalengka">Kec. Cicalengka</option>
              </select>
            </div>
            <div>
              <label class="font-bold text-[#09090b] block mb-1">Alamat Lengkap Sekretariat:</label>
              <input type="text" placeholder="Jl. Raya Soreang No. 45 RT 02/RW 04" class="w-full px-3.5 py-2.5 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-medium focus:outline-none focus:border-[#064e3b]" required/>
            </div>
          </div>

          <!-- Susunan Pengurus -->
          <div class="pt-3 border-t border-[#ececee] space-y-3">
            <span class="font-bold text-xs text-[#064e3b] uppercase tracking-wider block">Susunan Pengurus Inti UPZ</span>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">Nama Ketua UPZ:</label>
                <input type="text" placeholder="Nama Lengkap & Gelar" class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs focus:outline-none focus:border-[#064e3b]" required/>
              </div>
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">NIK KTP Ketua:</label>
                <input type="text" placeholder="16 Digit NIK" class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-mono focus:outline-none focus:border-[#064e3b]" required/>
              </div>
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">No. WhatsApp Ketua:</label>
                <input type="text" placeholder="0812xxxxxxxx" class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-mono focus:outline-none focus:border-[#064e3b]" required/>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">Nama Bendahara UPZ:</label>
                <input type="text" placeholder="Nama Lengkap Bendahara" class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs focus:outline-none focus:border-[#064e3b]" required/>
              </div>
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">NIK KTP Bendahara:</label>
                <input type="text" placeholder="16 Digit NIK" class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-mono focus:outline-none focus:border-[#064e3b]" required/>
              </div>
              <div>
                <label class="text-[#71717a] block mb-1 font-semibold">Pilihan Rekening Virtual Account:</label>
                <select class="w-full px-3 py-2 rounded-xl bg-[#f4f4f5] border border-[#ececee] text-xs font-semibold focus:outline-none focus:border-[#064e3b]">
                  <option value="bsi">Bank Syariah Indonesia (BSI VA)</option>
                  <option value="bjb">Bank BJB Syariah (BJB VA)</option>
                </select>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-[#ececee]">
            <button type="submit" class="w-full py-3 rounded-xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-bold flex items-center justify-center gap-2 shadow-xs transition-all">
              <span class="material-symbols-outlined text-base">verified</span>
              <span>Terbitkan SK Resmi &amp; Aktifkan UPZ</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Sidebar Guidance (4 Cols) -->
      <section class="lg:col-span-4 space-y-5">
        <div class="bg-white rounded-[32px] border border-[#ececee] p-6 space-y-3.5 shadow-xs text-xs text-[#52525b]">
          <h3 class="font-bold text-sm text-[#09090b] flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-[#064e3b]">policy</span>
            <span>Syarat Penerbitan SK BAZNAS</span>
          </h3>
          <ul class="space-y-2 list-disc pl-4 text-[11px] leading-relaxed">
            <li>Memiliki susunan pengurus minimal 3 orang (Ketua, Sekretaris, Bendahara).</li>
            <li>Melampirkan rekomendasi dari Camat setempat atau pimpinan instansi kedinasan.</li>
            <li>Berkomitmen menyetorkan 100% perolehan kotor ZIS ke rekening penampungan BAZNAS.</li>
            <li>Menerima hak kelola amil 12.5% yang dibayarkan terjadwal setiap akhir bulan via H2H.</li>
          </ul>
        </div>

        <div class="bg-white rounded-[32px] border border-[#ececee] p-6 space-y-3 shadow-xs text-xs text-[#52525b]">
          <span class="text-xs font-bold uppercase tracking-wider text-[#064e3b] block">Masa Berlaku SK UPZ</span>
          <p class="text-[11px] leading-relaxed">
            Surat Keputusan (SK) berlaku selama <strong>3 (tiga) tahun</strong> sejak tanggal pengesahan dan dapat diperpanjang melalui evaluasi kinerja penghimpunan tahunan.
          </p>
        </div>
      </section>

    </div>

  </main>
</AdminLayout>
