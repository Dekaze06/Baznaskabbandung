  <!-- Interactive Client-side Tab Script -->
  <script is:inline>
    (function initPublicAccountPanel() {
      const tabs = [
        { id: 'transaksi', btn: 'tabBtnTransaksi', panel: 'panelTransaksi' },
        { id: 'bantuan', btn: 'tabBtnBantuan', panel: 'panelBantuan' },
        { id: 'pengingat', btn: 'tabBtnPengingat', panel: 'panelPengingat' },
        { id: 'profil', btn: 'tabBtnProfil', panel: 'panelProfil' }
      ];

      function activateTab(tabId) {
        const target = tabs.find(t => t.id === tabId) || tabs[0];
        tabs.forEach(t => {
          const b = document.getElementById(t.btn);
          const p = document.getElementById(t.panel);
          if (b) {
            b.className = 'px-5 py-3 text-xs font-semibold text-[#71717a] hover:text-[#09090b] border-b-2 border-transparent flex items-center gap-2 shrink-0 transition-all';
            const icon = b.querySelector('.material-symbols-outlined');
            if (icon) icon.className = 'material-symbols-outlined text-base text-[#71717a]';
          }
          if (p) p.classList.add('hidden');
        });

        const activeBtn = document.getElementById(target.btn);
        const activePanel = document.getElementById(target.panel);
        if (activeBtn) {
          activeBtn.className = 'px-5 py-3 text-xs font-bold border-b-2 border-[#064e3b] text-[#09090b] flex items-center gap-2 shrink-0 transition-all';
          const activeIcon = activeBtn.querySelector('.material-symbols-outlined');
          if (activeIcon) activeIcon.className = 'material-symbols-outlined text-base text-[#064e3b]';
        }
        if (activePanel) {
          activePanel.classList.remove('hidden');
        }
      }

      tabs.forEach(({ id, btn }) => {
        document.getElementById(btn)?.addEventListener('click', () => {
          activateTab(id);
          if (history.replaceState) {
            history.replaceState(null, '', '#' + id);
          }
        });
      });

      // Handle direct hash navigation
      const currentHash = window.location.hash.replace('#', '');
      if (currentHash && tabs.some(t => t.id === currentHash)) {
        activateTab(currentHash);
      }

      window.addEventListener('hashchange', () => {
        const hash = window.location.hash.replace('#', '');
        if (hash && tabs.some(t => t.id === hash)) {
          activateTab(hash);
        }
      });
    })();
  </script>
