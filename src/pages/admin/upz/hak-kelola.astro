  <script is:inline>
    const inputHimpunan = document.getElementById('input-himpunan');
    const calcTotalAmil = document.getElementById('calc-total-amil');
    const calcPorsiUpz = document.getElementById('calc-porsi-upz');
    const calcPorsiKab = document.getElementById('calc-porsi-kab');
    const calcNetTransfer = document.getElementById('calc-net-transfer');

    function formatRupiah(num) {
      return 'Rp ' + Math.round(num).toLocaleString('id-ID');
    }

    if (inputHimpunan) {
      inputHimpunan.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value) || 0;
        const amilTotal = val * 0.125;
        const upzShare = val * 0.06;
        const kabShare = val * 0.0625;

        if (calcTotalAmil) calcTotalAmil.textContent = formatRupiah(amilTotal);
        if (calcPorsiUpz) calcPorsiUpz.textContent = formatRupiah(upzShare);
        if (calcPorsiKab) calcPorsiKab.textContent = formatRupiah(kabShare);
        if (calcNetTransfer) calcNetTransfer.textContent = formatRupiah(upzShare);
      });
    }
  </script>
