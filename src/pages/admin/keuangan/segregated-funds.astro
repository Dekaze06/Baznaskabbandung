---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Kas 5 Segregated Funds - Panel Admin BAZNAS" sectionName="Tata Kelola & Akuntansi" pageTitle="Kas 5 Segregated Funds (Pemisahan Dana Syariah)" activeRoute="keuangan/segregated-funds">
  <main class="p-6 lg:p-8 space-y-7">

    <!-- Top Sub-Nav Pills for Module 3 -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Sub navigasi keuangan">
      <a href="/admin/keuangan" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        <span>Ikhtisar Keuangan</span>
      </a>
      <a href="/admin/keuangan/segregated-funds" class="px-4 py-2 rounded-full text-xs font-bold bg-[#064e3b] text-white flex items-center gap-1.5 shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-sm">account_tree</span>
        <span>Kas 5 Segregated Funds</span>
      </a>
      <a href="/admin/keuangan/jurnal" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">menu_book</span>
        <span>Buku Jurnal PSAK 109</span>
      </a>
      <a href="/admin/keuangan/transfer" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">send</span>
        <span>Antrean Transfer H2H</span>
        <span class="px-1.5 py-0.2 rounded-full bg-[#fef3c7] text-[#d97706] text-[10px] font-bold">6</span>
      </a>
      <a href="/admin/keuangan/rekonsiliasi" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">sync_alt</span>
        <span>Rekonsiliasi Bank</span>
      </a>
      <a href="/admin/keuangan/neraca" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">pie_chart</span>
        <span>Laporan Neraca</span>
      </a>
    </nav>

    <!-- Header Description Card -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">account_tree</span>
        </div>
        <div>
          <h1 class="text-lg font-bold text-[#09090b]">Pemisahan Kas &amp; Saldo Dana Syariah (Strict Fund Segregation)</h1>
          <p class="text-xs text-[#71717a] mt-0.5">Sesuai Fatwa DSN-MUI &amp; PSAK 109: Dana zakat, infak, amil, dan non-halal wajib berada di rekening terpisah</p>
        </div>
      </div>
      <div class="font-mono text-xs bg-[#f4f4f5] px-3.5 py-2 rounded-xl border border-[#ececee]">
        Total Kas Terkelola: <strong class="text-[#064e3b] font-bold">Rp 8.043.620.000</strong>
      </div>
    </section>

    <!-- Detailed 5 Segregated Funds Cards -->
    <div class="space-y-5">
      
      <!-- Fund 1: Dana Zakat -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
          <div class="flex items-center gap-3">
            <span class="w-3.5 h-3.5 rounded-full bg-[#064e3b]"></span>
            <div>
              <h3 class="font-bold text-base text-[#09090b]">1. Dana Zakat (Khusus 8 Asnaf Fikih)</h3>
              <span class="text-xs text-[#71717a]">Rekening Giro Bank BSI: <strong>714-2024-001 a.n. BAZNAS Kab Bandung Zakat</strong></span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-[#71717a] block">Saldo Kas Efektif:</span>
            <strong class="text-2xl font-bold font-mono text-[#064e3b]">Rp 4.821.450.000</strong>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Penerimaan YTD:</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 26.850.000.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Penyaluran 8 Asnaf YTD:</span>
            <strong class="font-mono text-sm text-[#064e3b] block mt-0.5">Rp 22.028.550.000 (82%)</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Ketentuan Syar'i:</span>
            <span class="font-semibold text-[#09090b] block mt-0.5">Mutlak Tidak Boleh Dipakai Operasional</span>
          </div>
        </div>
      </article>

      <!-- Fund 2: Dana Infak / Sedekah -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
          <div class="flex items-center gap-3">
            <span class="w-3.5 h-3.5 rounded-full bg-[#006a4e]"></span>
            <div>
              <h3 class="font-bold text-base text-[#09090b]">2. Dana Infak &amp; Sedekah (Terikat &amp; Tidak Terikat)</h3>
              <span class="text-xs text-[#71717a]">Rekening Giro Bank BJB Syariah: <strong>518-002-1920 a.n. BAZNAS Kab Bandung Infak</strong></span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-[#71717a] block">Saldo Kas Efektif:</span>
            <strong class="text-2xl font-bold font-mono text-[#09090b]">Rp 2.115.800.000</strong>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Infak Terikat (Rutilahu/Bencana):</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 1.265.800.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Infak Tidak Terikat (Umum):</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 850.000.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Ketentuan Syar'i:</span>
            <span class="font-semibold text-[#09090b] block mt-0.5">Dialokasikan sesuai akad munfiq / musyawaroh amil</span>
          </div>
        </div>
      </article>

      <!-- Fund 3: Dana DSKL -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
          <div class="flex items-center gap-3">
            <span class="w-3.5 h-3.5 rounded-full bg-[#3b82f6]"></span>
            <div>
              <h3 class="font-bold text-base text-[#09090b]">3. Dana DSKL (Dana Sosial Keagamaan Lainnya) &amp; Fidyah</h3>
              <span class="text-xs text-[#71717a]">Rekening Bank Muamalat: <strong>102-004-8891 a.n. BAZNAS Kab Bandung DSKL</strong></span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-[#71717a] block">Saldo Kas Efektif:</span>
            <strong class="text-2xl font-bold font-mono text-[#09090b]">Rp 430.120.000</strong>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Kafarat &amp; Fidyah Terkumpul:</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 210.120.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">CSR BUMD &amp; Kemitraan:</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 220.000.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Ketentuan Syar'i:</span>
            <span class="font-semibold text-[#09090b] block mt-0.5">Penyaluran paket makanan fakir &amp; sanitasi warga</span>
          </div>
        </div>
      </article>

      <!-- Fund 4: Dana Amil -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
          <div class="flex items-center gap-3">
            <span class="w-3.5 h-3.5 rounded-full bg-[#d97706]"></span>
            <div>
              <h3 class="font-bold text-base text-[#09090b]">4. Dana Amil (Hak Kelola Maksimal 12.5% ZIS)</h3>
              <span class="text-xs text-[#71717a]">Rekening Operasional Bank BSI: <strong>714-2024-009 a.n. Amil BAZNAS Bandung</strong></span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-[#71717a] block">Saldo Kas Efektif:</span>
            <strong class="text-2xl font-bold font-mono text-[#064e3b]">Rp 612.800.000</strong>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Hak Amil Terealisasi (YTD):</span>
            <strong class="font-mono text-sm text-[#064e3b] block mt-0.5">8,9% (Maksimal 12.5%)</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Beban Operasional &amp; IT:</span>
            <strong class="font-mono text-sm text-[#09090b] block mt-0.5">Rp 3.723.280.000</strong>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Ketentuan Syar'i:</span>
            <span class="font-semibold text-[#064e3b] block mt-0.5">Sisa hak amil efisien dikembalikan ke saldo dana amil</span>
          </div>
        </div>
      </article>

      <!-- Fund 5: Dana Non-Halal -->
      <article class="bg-white rounded-3xl border border-[#ececee] p-6 space-y-4 shadow-xs card-hover-lift">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#ececee]">
          <div class="flex items-center gap-3">
            <span class="w-3.5 h-3.5 rounded-full bg-[#ff5a00]"></span>
            <div>
              <h3 class="font-bold text-base text-[#09090b]">5. Dana Non-Halal (Jasa Giro &amp; Pendapatan Non-Halal)</h3>
              <span class="text-xs text-[#71717a]">Rekening Penampungan Khusus Bank BSI Non-Halal</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-[#71717a] block">Saldo Kas Efektif:</span>
            <strong class="text-2xl font-bold font-mono text-[#ff5a00]">Rp 63.450.000</strong>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Sumber Dana:</span>
            <span class="font-semibold text-[#09090b] block mt-0.5">Jasa Giro Rekening Bank Konvensional Lama</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Rencana Penyaluran:</span>
            <span class="font-semibold text-[#09090b] block mt-0.5">Pembangunan MCK Umum &amp; Pengaspalan Jalan Desa</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-[#f8fafc] border border-[#ececee]">
            <span class="text-[#71717a] block">Ketentuan Syar'i:</span>
            <span class="font-semibold text-[#ff5a00] block mt-0.5">Haram Dimakan / Diberikan Langsung ke Mustahik</span>
          </div>
        </div>
      </article>

    </div>

  </main>
</AdminLayout>
