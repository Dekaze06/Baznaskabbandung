---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Keuangan & PSAK 109 - Panel Admin BAZNAS" sectionName="Tata Kelola & Akuntansi" pageTitle="Keuangan & Akuntansi Syariah PSAK 109" activeRoute="keuangan">
  <main class="p-6 lg:p-8 space-y-7">

    <!-- Top Sub-Nav Pills for Module 3 -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-1" aria-label="Sub navigasi keuangan">
      <a href="/admin/keuangan" class="px-4 py-2 rounded-full text-xs font-bold bg-[#064e3b] text-white flex items-center gap-1.5 shrink-0 shadow-xs">
        <span class="material-symbols-outlined text-sm">dashboard</span>
        <span>Ikhtisar Keuangan</span>
      </a>
      <a href="/admin/keuangan/segregated-funds" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">account_tree</span>
        <span>Kas 5 Segregated Funds</span>
      </a>
      <a href="/admin/keuangan/jurnal" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">menu_book</span>
        <span>Buku Jurnal PSAK 109</span>
      </a>
      <a href="/admin/keuangan/transfer" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">send</span>
        <span>Antrean Transfer H2H</span>
        <span class="px-1.5 py-0.2 rounded-full bg-[#fef3c7] text-[#d97706] text-[10px] font-bold">6</span>
      </a>
      <a href="/admin/keuangan/rekonsiliasi" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">sync_alt</span>
        <span>Rekonsiliasi Bank</span>
      </a>
      <a href="/admin/keuangan/neraca" class="px-4 py-2 rounded-full text-xs font-medium bg-white hover:bg-[#f4f4f5] border border-[#ececee] text-[#52525b] hover:text-[#064e3b] flex items-center gap-1.5 shrink-0 transition-all">
        <span class="material-symbols-outlined text-sm text-[#064e3b]">pie_chart</span>
        <span>Laporan Neraca</span>
      </a>
    </nav>

    <!-- Operational Header Banner -->
    <section class="bg-white rounded-[32px] border border-[#ececee] p-6 lg:p-7 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-center gap-5">
        <div class="w-14 h-14 rounded-2xl bg-[#064e3b] flex items-center justify-center text-white shrink-0 shadow-md">
          <span class="material-symbols-outlined text-[28px]">account_balance</span>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <h1 class="text-xl font-bold text-[#09090b] tracking-tight">Direktorat Keuangan &amp; Akuntansi PSAK 109</h1>
            <span class="px-2.5 py-0.5 rounded-full bg-[#ecfdf5] text-[#064e3b] font-mono text-[11px] font-bold border border-[#064e3b]/20">NODE 3204 WTP</span>
          </div>
          <p class="text-xs text-[#71717a] mt-1">
            Pengelolaan 5 Kantong Kas Syariah Terpisah • Buku Besar Double-Entry PSAK 109 • Kliring H2H BI-FAST Bank Syariah
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button type="button" data-action="open-journal" class="px-4 py-2 rounded-xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-semibold flex items-center gap-1.5 shadow-xs transition-all">
          <span class="material-symbols-outlined text-base">post_add</span>
          <span>Posting Jurnal Cepat</span>
        </button>
      </div>
    </section>

    <!-- 5 Kas Segregated Summary Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <div class="bg-white rounded-[28px] border border-[#ececee] p-5 shadow-xs flex flex-col justify-between card-hover-lift">
        <div>
          <span class="text-xs font-bold text-[#71717a] block uppercase">1. Dana Zakat</span>
          <strong class="text-xl font-bold font-mono text-[#09090b] block mt-1">Rp 4,82 M</strong>
          <span class="text-[11px] text-[#71717a]">Rp 4.821.450.000</span>
        </div>
        <div class="pt-3 mt-3 border-t border-[#ececee] text-[11px] flex justify-between">
          <span class="text-[#71717a]">Hak 8 Asnaf</span>
          <span class="font-bold text-[#064e3b]">82% Terdistribusi</span>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-[#ececee] p-5 shadow-xs flex flex-col justify-between card-hover-lift">
        <div>
          <span class="text-xs font-bold text-[#71717a] block uppercase">2. Infak / Sedekah</span>
          <strong class="text-xl font-bold font-mono text-[#09090b] block mt-1">Rp 2,11 M</strong>
          <span class="text-[11px] text-[#71717a]">Rp 2.115.800.000</span>
        </div>
        <div class="pt-3 mt-3 border-t border-[#ececee] text-[11px] flex justify-between">
          <span class="text-[#71717a]">Infak Terikat</span>
          <span class="font-bold text-[#09090b]">Rp 850 Jt</span>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-[#ececee] p-5 shadow-xs flex flex-col justify-between card-hover-lift">
        <div>
          <span class="text-xs font-bold text-[#71717a] block uppercase">3. DSKL &amp; Fidyah</span>
          <strong class="text-xl font-bold font-mono text-[#09090b] block mt-1">Rp 430 Jt</strong>
          <span class="text-[11px] text-[#71717a]">Rp 430.120.000</span>
        </div>
        <div class="pt-3 mt-3 border-t border-[#ececee] text-[11px] flex justify-between">
          <span class="text-[#71717a]">Salur Sosial</span>
          <span class="font-bold text-[#09090b]">Rp 640 Jt</span>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-[#ececee] p-5 shadow-xs flex flex-col justify-between card-hover-lift">
        <div>
          <span class="text-xs font-bold text-[#71717a] block uppercase">4. Dana Amil</span>
          <strong class="text-xl font-bold font-mono text-[#064e3b] block mt-1">Rp 612 Jt</strong>
          <span class="text-[11px] text-[#71717a]">Rp 612.800.000</span>
        </div>
        <div class="pt-3 mt-3 border-t border-[#ececee] text-[11px] flex justify-between">
          <span class="text-[#71717a]">Maks 12.5%</span>
          <span class="font-bold text-[#064e3b]">8.9% (Efisien)</span>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-[#ececee] p-5 shadow-xs flex flex-col justify-between card-hover-lift">
        <div>
          <span class="text-xs font-bold text-[#71717a] block uppercase">5. Non-Halal</span>
          <strong class="text-xl font-bold font-mono text-[#ff5a00] block mt-1">Rp 63 Jt</strong>
          <span class="text-[11px] text-[#71717a]">Rp 63.450.000</span>
        </div>
        <div class="pt-3 mt-3 border-t border-[#ececee] text-[11px] flex justify-between">
          <span class="text-[#71717a]">Jasa Giro Bank</span>
          <span class="font-bold text-[#ff5a00]">Bina Sarana</span>
        </div>
      </div>
    </section>

    <!-- Hub 5 Sub Menu Terpisah Keuangan -->
    <section class="space-y-4">
      <h2 class="text-base font-bold text-[#09090b]">Navigasi 5 Sub Menu Keuangan &amp; Akuntansi</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        
        <a href="/admin/keuangan/segregated-funds" class="p-6 rounded-3xl bg-white border border-[#ececee] shadow-xs hover:border-[#064e3b] transition-all card-hover-lift group">
          <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center mb-4 group-hover:bg-[#064e3b] group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">account_tree</span>
          </div>
          <h3 class="font-bold text-base text-[#09090b]">Kas 5 Segregated Funds</h3>
          <p class="text-xs text-[#71717a] mt-1">Detail pemisahan kas syariah: Zakat, Infak Terikat, DSKL, Amil, dan Non-Halal di bank mitra.</p>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] mt-4">
            <span>Buka Kas Terpisah</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
        </a>

        <a href="/admin/keuangan/jurnal" class="p-6 rounded-3xl bg-white border border-[#ececee] shadow-xs hover:border-[#064e3b] transition-all card-hover-lift group">
          <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center mb-4 group-hover:bg-[#064e3b] group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">menu_book</span>
          </div>
          <h3 class="font-bold text-base text-[#09090b]">Buku Jurnal PSAK 109</h3>
          <p class="text-xs text-[#71717a] mt-1">Daftar buku jurnal memorial double-entry, kode akun COA syariah, dan audit trail SHA-256.</p>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] mt-4">
            <span>Lihat Jurnal Umum</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
        </a>

        <a href="/admin/keuangan/transfer" class="p-6 rounded-3xl bg-white border border-[#ececee] shadow-xs hover:border-[#064e3b] transition-all card-hover-lift group">
          <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center mb-4 group-hover:bg-[#064e3b] group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">send</span>
          </div>
          <h3 class="font-bold text-base text-[#09090b]">Antrean Transfer H2H</h3>
          <p class="text-xs text-[#71717a] mt-1">Disposisi transfer penyaluran host-to-host bank syariah (BSI, BJB Syariah) BI-FAST langsung ke mustahik.</p>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] mt-4">
            <span>Buka Antrean Transfer</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
        </a>

        <a href="/admin/keuangan/rekonsiliasi" class="p-6 rounded-3xl bg-white border border-[#ececee] shadow-xs hover:border-[#064e3b] transition-all card-hover-lift group">
          <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center mb-4 group-hover:bg-[#064e3b] group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">sync_alt</span>
          </div>
          <h3 class="font-bold text-base text-[#09090b]">Rekonsiliasi Bank Syariah</h3>
          <p class="text-xs text-[#71717a] mt-1">Pencocokan mutasi bank otomatis vs pembukuan internal (BSI, BJB Syariah, Muamalat) selisih nol.</p>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] mt-4">
            <span>Lihat Rekonsiliasi</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
        </a>

        <a href="/admin/keuangan/neraca" class="p-6 rounded-3xl bg-white border border-[#ececee] shadow-xs hover:border-[#064e3b] transition-all card-hover-lift group">
          <div class="w-12 h-12 rounded-2xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center mb-4 group-hover:bg-[#064e3b] group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-2xl">pie_chart</span>
          </div>
          <h3 class="font-bold text-base text-[#09090b]">Laporan Neraca PSAK 109</h3>
          <p class="text-xs text-[#71717a] mt-1">Laporan posisi keuangan komparatif Aset Lancar vs Liabilitas &amp; Saldo Dana Zakat/Infak/Amil.</p>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[#064e3b] mt-4">
            <span>Buka Laporan Neraca</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
        </a>

      </div>
    </section>

  </main>
</AdminLayout>
