---
import PublicLayout from '../../layouts/PublicLayout.astro';
import InkOrbitFeatures from '../../components/ui/ink-orbit-features';
---

<PublicLayout 
  title="Dashboard Penyaluran & Sebaran Manfaat ZIS - BAZNAS Kabupaten Bandung"
  description="Peta sebaran pendistribusian dana ZIS ke 31 kecamatan di Kabupaten Bandung, rincian hak 8 asnaf, pengentasan kemiskinan ekstrem, dan verifikasi Had Kifayah berbasis CIBEST model."
>
  <main class="flex-1 bg-[#fcfcfc] py-8 lg:py-14">
    <div class="max-w-[1400px] mx-auto px-6 space-y-12">
      
      <!-- BREADCRUMB & HEADER -->
      <section class="space-y-6">
        <nav class="flex items-center gap-2 text-xs text-[#71717a] font-medium">
          <a href="/" class="hover:text-[#064e3b] transition-colors">Beranda</a>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span>Dashboard</span>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-[#09090b] font-semibold">Penyaluran &amp; Manfaat</span>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-[#e4e4e7] pb-8">
          <div class="max-w-3xl space-y-3">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#09090b] tracking-tight">
              Peta Penyaluran &amp; Sebaran Manfaat ZIS
            </h1>
            <p class="text-sm sm:text-base text-[#52525b] leading-relaxed">
              Transparansi pendistribusian hak 8 asnaf di 31 kecamatan Kabupaten Bandung berdasarkan pengukuran ilmiah Had Kifayah dan Model CIBEST (Center of Islamic Business and Economic Studies) IPB &amp; BAZNAS RI.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <button onclick="window.print?.()" class="inline-flex items-center gap-2 px-4 py-3 rounded-2xl bg-white hover:bg-[#f4f4f5] border border-[#e4e4e7] text-[#09090b] text-xs font-semibold transition-all shadow-xs">
              <span class="material-symbols-outlined text-base text-[#064e3b]">print</span>
              <span>Cetak Rekapitulasi</span>
            </button>
            <a href="/layanan/bantuan" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-[#064e3b] hover:bg-[#006a4e] text-white text-xs font-bold transition-all shadow-xs">
              <span class="material-symbols-outlined text-base">person_search</span>
              <span>Cek Status Bantuan NIK</span>
            </a>
          </div>
        </div>
      </section>

      <!-- 4 TOP KPI METRIC CARDS -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-3xl border border-[#e4e4e7] p-6 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs text-[#71717a] font-medium">Total Dana Disalurkan</span>
            <span class="p-2 rounded-xl bg-[#ecfdf5] text-[#064e3b]">
              <span class="material-symbols-outlined text-lg">volunteer_activism</span>
            </span>
          </div>
          <div class="text-3xl font-extrabold font-mono text-[#064e3b]">Rp 38,45 M</div>
          <div class="text-xs text-[#71717a]">
            Realisasi 8 Asnaf per Oktober 2026
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-[#e4e4e7] p-6 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs text-[#71717a] font-medium">Penerima Manfaat</span>
            <span class="p-2 rounded-xl bg-[#f4f4f5] text-[#71717a]">
              <span class="material-symbols-outlined text-lg">family_restroom</span>
            </span>
          </div>
          <div class="text-3xl font-extrabold font-mono text-[#09090b]">94.280 Jiwa</div>
          <div class="text-xs text-[#71717a]">
            Individu &amp; KK mustahik terverifikasi
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-[#e4e4e7] p-6 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs text-[#71717a] font-medium">Cakupan Kewilayahan</span>
            <span class="p-2 rounded-xl bg-[#f4f4f5] text-[#71717a]">
              <span class="material-symbols-outlined text-lg">pin_drop</span>
            </span>
          </div>
          <div class="text-3xl font-extrabold font-mono text-[#09090b]">31 Kecamatan</div>
          <div class="text-xs text-[#71717a]">
            270 desa/kelurahan se-Kabupaten Bandung
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-[#e4e4e7] p-6 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs text-[#71717a] font-medium">Indeks Efektivitas CIBEST</span>
            <span class="p-2 rounded-xl bg-[#ecfdf5] text-[#064e3b]">
              <span class="material-symbols-outlined text-lg">insights</span>
            </span>
          </div>
          <div class="text-3xl font-extrabold font-mono text-[#064e3b]">0.884</div>
          <div class="text-xs text-[#71717a]">
            Kategori Sangat Efektif mengentaskan kemiskinan
          </div>
        </div>
      </section>

      <!-- GRAFIK 1: MANDAT SYARIAH 8 ASNAF (QS. AT-TAUBAH: 60) DENGAN DONUT CHART & MATRIKS -->
      <section class="bg-white rounded-3xl border border-[#e4e4e7] p-7 lg:p-10 space-y-8 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#f4f4f5] pb-5">
          <div>
            <h2 class="text-2xl font-bold text-[#09090b]">Grafik Alokasi Syariah 8 Asnaf (QS. At-Taubah: 60)</h2>
            <p class="text-xs text-[#71717a] mt-1">Proporsi penyaluran zakat wajib memenuhi koridor ketentuan syariat Islam dan peraturan perundang-undangan</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-full bg-[#ecfdf5] text-[#064e3b] text-xs font-mono font-bold border border-[#064e3b]/20">
              Kepatuhan Syariah: 100% Valid
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Visual Donut Chart 8 Asnaf (5 cols) -->
          <div class="lg:col-span-5 flex flex-col items-center justify-center relative p-4">
            <svg class="w-60 h-60 -rotate-90 transform" viewBox="0 0 100 100">
              <!-- Background Ring -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#f4f4f5" stroke-width="13"></circle>
              
              <!-- 1. Fakir: 38.5% -> length = 91.92, offset = 0 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#064e3b" stroke-width="13" stroke-dasharray="91.92 146.84" stroke-dashoffset="0" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 2. Miskin: 32.0% -> length = 76.40, offset = -91.92 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#047857" stroke-width="13" stroke-dasharray="76.40 162.36" stroke-dashoffset="-91.92" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 3. Fisabilillah: 10.2% -> length = 24.35, offset = -168.32 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#10b981" stroke-width="13" stroke-dasharray="24.35 214.41" stroke-dashoffset="-168.32" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 4. Amil: 9.8% -> length = 23.40, offset = -192.67 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#34d399" stroke-width="13" stroke-dasharray="23.40 215.36" stroke-dashoffset="-192.67" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 5. Gharimin: 4.2% -> length = 10.03, offset = -216.07 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#64748b" stroke-width="13" stroke-dasharray="10.03 228.73" stroke-dashoffset="-216.07" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 6. Ibnu Sabil: 2.4% -> length = 5.73, offset = -226.10 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#94a3b8" stroke-width="13" stroke-dasharray="5.73 233.03" stroke-dashoffset="-226.10" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 7. Muallaf: 2.1% -> length = 5.01, offset = -231.83 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#cbd5e1" stroke-width="13" stroke-dasharray="5.01 233.75" stroke-dashoffset="-231.83" class="transition-all hover:opacity-80 cursor-pointer"></circle>
              
              <!-- 8. Riqab: 0.8% -> length = 1.91, offset = -236.84 -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#e2e8f0" stroke-width="13" stroke-dasharray="1.91 236.85" stroke-dashoffset="-236.84" class="transition-all hover:opacity-80 cursor-pointer"></circle>
            </svg>

            <!-- Center KPI Inside Donut -->
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
              <span class="text-[9px] text-[#71717a] font-bold uppercase tracking-wider font-mono">REALISASI 8 ASNAF</span>
              <span class="text-xl font-extrabold font-mono text-[#064e3b]">Rp 38,45 M</span>
              <span class="text-[10px] text-[#71717a] font-medium">94.280 Mustahik</span>
            </div>
          </div>

          <!-- Asnaf Segment Breakdown Grid (7 cols) -->
          <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            
            <!-- 1. Fakir -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#064e3b] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#064e3b] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">1. Asnaf Fakir</span>
                </div>
                <span class="font-mono font-bold text-[#064e3b]">38.5%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#064e3b]">Rp 14,80 M</span>
                <span class="text-[11px] text-[#71717a]">36.300 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Lansia sebatang kara, bedah Rutilahu, paket pangan darurat.</p>
            </div>

            <!-- 2. Miskin -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#047857] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#047857] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">2. Asnaf Miskin</span>
                </div>
                <span class="font-mono font-bold text-[#047857]">32.0%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 12,30 M</span>
                <span class="text-[11px] text-[#71717a]">30.170 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Modal usaha Z-Auto &amp; Z-Chicken, beasiswa santri, advokasi ijazah.</p>
            </div>

            <!-- 3. Fisabilillah -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#10b981] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#10b981] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">3. Asnaf Fisabilillah</span>
                </div>
                <span class="font-mono font-bold text-[#10b981]">10.2%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 3,92 M</span>
                <span class="text-[11px] text-[#71717a]">9.610 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Insentif kehormatan da'i pelosok, guru ngaji desa, sarana dakwah.</p>
            </div>

            <!-- 4. Amil Syar'i -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#34d399] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#34d399] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">4. Asnaf Amil (Syar'i)</span>
                </div>
                <span class="font-mono font-bold text-[#064e3b]">9.8%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#064e3b]">Rp 3,76 M</span>
                <span class="text-[11px] text-[#71717a]">31 UPZ &amp; Tim</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Biaya operasional amil resmi (&le; 12.5% batas syariah), audit KAP.</p>
            </div>

            <!-- 5. Gharimin -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#64748b] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#64748b] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">5. Asnaf Gharimin</span>
                </div>
                <span class="font-mono font-bold text-[#64748b]">4.2%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 1,61 M</span>
                <span class="text-[11px] text-[#71717a]">3.950 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Penyelamatan jeratan rentenir darurat &amp; tunggakan medis RS.</p>
            </div>

            <!-- 6. Ibnu Sabil -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#94a3b8] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#94a3b8] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">6. Asnaf Ibnu Sabil</span>
                </div>
                <span class="font-mono font-bold text-[#94a3b8]">2.4%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 0,92 M</span>
                <span class="text-[11px] text-[#71717a]">2.260 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Bantuan musafir terlantar &amp; santri kehabisan bekal perjalanan.</p>
            </div>

            <!-- 7. Muallaf -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#cbd5e1] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#cbd5e1] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">7. Asnaf Muallaf</span>
                </div>
                <span class="font-mono font-bold text-[#71717a]">2.1%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 0,81 M</span>
                <span class="text-[11px] text-[#71717a]">1.980 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Bimbingan syariah terpadu, pembinaan akidah, dan modal usaha.</p>
            </div>

            <!-- 8. Riqab -->
            <div class="p-3.5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7] space-y-1 hover:border-[#e2e8f0] transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-md bg-[#e2e8f0] border border-[#cbd5e1] shrink-0"></span>
                  <span class="font-bold text-[#09090b]">8. Asnaf Riqab</span>
                </div>
                <span class="font-mono font-bold text-[#71717a]">0.8%</span>
              </div>
              <div class="flex items-baseline justify-between pt-1">
                <span class="text-base font-extrabold font-mono text-[#09090b]">Rp 0,31 M</span>
                <span class="text-[11px] text-[#71717a]">750 Jiwa</span>
              </div>
              <p class="text-[10px] text-[#52525b] leading-tight">Advokasi PMI dhuafa bermasalah dan perlindungan eksploitasi.</p>
            </div>

          </div>

        </div>
      </section>

      <!-- GRAFIK 2: KOMPARASI 5 PILAR PROGRAM BAZNAS (INTERACTIVE DUAL-VIEW BARS) -->
      <section class="bg-white rounded-3xl border border-[#e4e4e7] p-7 lg:p-10 space-y-8 shadow-xs">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#f4f4f5] pb-5">
          <div>
            <h2 class="text-2xl font-bold text-[#09090b]">Komparasi Realisasi Penyaluran 5 Pilar Program</h2>
            <p class="text-xs text-[#71717a] mt-1">Perbandingan alokasi dana dan jangkauan mustahik pada 5 pilar program unggulan</p>
          </div>

          <!-- Dual View Selector Toggle -->
          <div class="inline-flex p-1 rounded-2xl bg-[#f4f4f5] border border-[#e4e4e7] text-xs font-semibold">
            <button 
              id="btn-view-nominal" 
              onclick="switchPillarView('nominal')"
              class="px-4 py-2 rounded-xl transition-all bg-white text-[#064e3b] shadow-xs"
            >
              Nominal Alokasi (Rp)
            </button>
            <button 
              id="btn-view-mustahik" 
              onclick="switchPillarView('mustahik')"
              class="px-4 py-2 rounded-xl transition-all text-[#71717a] hover:text-[#09090b]"
            >
              Jumlah Mustahik (Jiwa)
            </button>
          </div>
        </div>

        <!-- 5 Horizontal Progress Bars Matrix -->
        <div class="space-y-6">
          
          <!-- Pillar 1: Bandung Sehat -->
          <div class="space-y-2 p-5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-lg">medical_services</span>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[#09090b]">Bandung Sehat</h3>
                  <span class="text-[11px] text-[#71717a]">Layanan medis darurat, hemodialisa gratis, ambulans 24 jam</span>
                </div>
              </div>
              <div class="text-right font-mono">
                <span id="sehat-val" class="text-base font-extrabold text-[#064e3b]">Rp 9,25 M</span>
                <span id="sehat-pct" class="text-xs text-[#71717a] block">24.1% dari total</span>
              </div>
            </div>
            <div class="w-full h-3 rounded-full bg-[#e4e4e7] overflow-hidden">
              <div id="sehat-bar" class="h-full bg-[#064e3b] rounded-full transition-all duration-500" style="width: 24.1%;"></div>
            </div>
            <div class="flex justify-between text-[11px] text-[#71717a] pt-1">
              <span>Mustahik: <strong class="text-[#09090b]">28.400 Jiwa</strong> (30.1%)</span>
              <span>Efisiensi: <strong class="text-[#064e3b] font-mono">Rp 325.700 / jiwa</strong></span>
            </div>
          </div>

          <!-- Pillar 2: Bandung Cerdas -->
          <div class="space-y-2 p-5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-lg">school</span>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[#09090b]">Bandung Cerdas</h3>
                  <span class="text-[11px] text-[#71717a]">Beasiswa SKSS santri dhuafa, tebus ijazah tertahan, perlengkapan belajar</span>
                </div>
              </div>
              <div class="text-right font-mono">
                <span id="cerdas-val" class="text-base font-extrabold text-[#064e3b]">Rp 8,60 M</span>
                <span id="cerdas-pct" class="text-xs text-[#71717a] block">22.4% dari total</span>
              </div>
            </div>
            <div class="w-full h-3 rounded-full bg-[#e4e4e7] overflow-hidden">
              <div id="cerdas-bar" class="h-full bg-[#047857] rounded-full transition-all duration-500" style="width: 22.4%;"></div>
            </div>
            <div class="flex justify-between text-[11px] text-[#71717a] pt-1">
              <span>Mustahik: <strong class="text-[#09090b]">31.200 Jiwa</strong> (33.1%)</span>
              <span>Efisiensi: <strong class="text-[#064e3b] font-mono">Rp 275.600 / jiwa</strong></span>
            </div>
          </div>

          <!-- Pillar 3: Bandung Makmur -->
          <div class="space-y-2 p-5 rounded-2xl bg-[#fafafa] border border-[#e4e4e7]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-[#ecfdf5] text-[#064e3b] flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-lg">storefront</span>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[#09090b]">Bandung Makmur (Pemberdayaan Ekonomi)</h3>
                  <span class="text-[11px] text-[#71717a]">Permodalan bergulir tanpa bunga, Z-Auto, Z-Chicken, lumbung pangan tani</span>
                </div>
              </div>
              <div class="text-right font-mono">
                <span id="makmur-val" class="text-base font-extrabold text-[#064e3b]">Rp 8,45 M</span>
