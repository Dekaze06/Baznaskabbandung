  <script is:inline>
    // Real-Time Search Kecamatan Filter
    const searchInput = document.getElementById('search-kecamatan');
    const items = document.querySelectorAll('#kecamatan-items > div');
    const matchCount = document.getElementById('match-count');

    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      let visible = 0;
      items.forEach(item => {
        const text = (item.getAttribute('data-name') || item.textContent).toLowerCase();
        if (text.includes(q)) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });
      if (matchCount) {
        matchCount.textContent = `Menampilkan ${visible} Kecamatan`;
      }
    });

    // Dual-View Toggle for 5 Pillars (Nominal vs Mustahik)
    const pillarData = {
      nominal: {
        sehat: { val: 'Rp 9,25 M', pct: '24.1% dari total', bar: '24.1%' },
        cerdas: { val: 'Rp 8,60 M', pct: '22.4% dari total', bar: '22.4%' },
        makmur: { val: 'Rp 8,45 M', pct: '22.0% dari total', bar: '22.0%' },
        peduli: { val: 'Rp 7,95 M', pct: '20.7% dari total', bar: '20.7%' },
        taqwa: { val: 'Rp 4,20 M', pct: '10.9% dari total', bar: '10.9%' }
      },
      mustahik: {
        sehat: { val: '28.400 Jiwa', pct: '30.1% mustahik', bar: '30.1%' },
        cerdas: { val: '31.200 Jiwa', pct: '33.1% mustahik', bar: '33.1%' },
        makmur: { val: '14.500 Jiwa', pct: '15.4% mustahik', bar: '15.4%' },
        peduli: { val: '15.680 Jiwa', pct: '16.6% mustahik', bar: '16.6%' },
        taqwa: { val: '4.500 Jiwa', pct: '4.8% mustahik', bar: '4.8%' }
      }
    };

    window.switchPillarView = function(view) {
      const btnNominal = document.getElementById('btn-view-nominal');
      const btnMustahik = document.getElementById('btn-view-mustahik');
      const data = pillarData[view];
      if (!data) return;

      if (view === 'nominal') {
        btnNominal?.classList.add('bg-white', 'text-[#064e3b]', 'shadow-xs');
        btnNominal?.classList.remove('text-[#71717a]');
        btnMustahik?.classList.remove('bg-white', 'text-[#064e3b]', 'shadow-xs');
        btnMustahik?.classList.add('text-[#71717a]');
      } else {
        btnMustahik?.classList.add('bg-white', 'text-[#064e3b]', 'shadow-xs');
        btnMustahik?.classList.remove('text-[#71717a]');
        btnNominal?.classList.remove('bg-white', 'text-[#064e3b]', 'shadow-xs');
        btnNominal?.classList.add('text-[#71717a]');
      }

      const pillars = ['sehat', 'cerdas', 'makmur', 'peduli', 'taqwa'];
      pillars.forEach(p => {
        const valEl = document.getElementById(`${p}-val`);
        const pctEl = document.getElementById(`${p}-pct`);
        const barEl = document.getElementById(`${p}-bar`);
        if (valEl) valEl.textContent = data[p].val;
        if (pctEl) pctEl.textContent = data[p].pct;
        if (barEl) barEl.style.width = data[p].bar;
      });
    };
  </script>
